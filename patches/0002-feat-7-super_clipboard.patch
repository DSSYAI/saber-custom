index 00000000..7dd653ea
--- /dev/null
+++ b/lib/pages/home/search.dart
@@ -0,0 +1,387 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:go_router/go_router.dart';
+import 'package:saber/data/file_manager/file_manager.dart';
+import 'package:saber/data/file_manager/note_search.dart';
+import 'package:saber/data/routes.dart';
+import 'package:worker_manager/worker_manager.dart';
+
+/// 个人自用版：全文搜索页（标题 + 正文）。
+///
+/// 未走 i18n，UI 文案直接使用中文字面量。
+class const SearchPage({super.key}) extends StatefulWidget {
+  @override
+  State<SearchPage> createState() => _SearchPageState();
+}
+
+/// 个人自用版：一条搜索结果。
+class NoteSearchResult {
+  /// The note's path without its extension, as used by [RoutePaths.editFilePath].
+  final String filePath;
+
+  /// A snippet of the note's text around the match,
+  /// or `null` if the note matched by its title only.
+  final String? snippet;
+
+  const new(this.filePath, this.snippet);
+
+  String get title => filePath.substring(filePath.lastIndexOf('/') + 1);
+
+  String get parentDirectory {
+    final directory = filePath.substring(0, filePath.lastIndexOf('/'));
+    return directory.isEmpty ? '/' : directory;
+  }
+}
+
+class _SearchPageState extends State<SearchPage> {
+  final queryController = TextEditingController();
+  final results = <NoteSearchResult>[];
+
+  var allFiles = <String>[];
+  var isLoadingFiles = true;
+  var isSearchingBodies = false;
+  var scannedBodies = 0;
+  var totalBodies = 0;
+  var titleOnly = false;
+
+  /// Incremented whenever the query changes, so that in-flight scans know
+  /// that their results are no longer wanted.
+  var generation = 0;
+
+  final runningScans = <Cancelable<String?>>[];
+  StreamSubscription? fileWriteSubscription;
+  Timer? debounce;
+
+  static const _debounceDuration = Duration(milliseconds: 200);
+
+  /// How many notes are read at the same time. worker_manager queues the rest.
+  static const _scanConcurrency = 3;
+
+  @override
+  void initState() {
+    super.initState();
+    queryController.addListener(_onQueryChanged);
+    fileWriteSubscription = FileManager.fileWriteStream.stream.listen((_) {
+      findFiles();
+    });
+    findFiles();
+  }
+
+  @override
+  void dispose() {
+    debounce?.cancel();
+    _cancelScans();
+    fileWriteSubscription?.cancel();
+    queryController.removeListener(_onQueryChanged);
+    queryController.dispose();
+    super.dispose();
+  }
+
+  Future<void> findFiles() async {
+    final files = await FileManager.getAllFiles(includeExtensions: true);
+    if (!mounted) return;
+
+    allFiles = files;
+    isLoadingFiles = false;
+    await search(queryController.text);
+  }
+
+  void _onQueryChanged() {
+    debounce?.cancel();
+    _cancelScans();
+    if (mounted) setState(() => isSearchingBodies = false);
+    debounce = Timer(_debounceDuration, () => search(queryController.text));
+  }
+
+  void _cancelScans() {
+    for (final scan in runningScans) {
+      scan.cancel();
+    }
+    runningScans.clear();
+  }
+
+  void _setResults(List<NoteSearchResult> newResults) {
+    results
+      ..clear()
+      ..addAll(newResults);
+  }
+
+  Future<void> search(String rawQuery) async {
+    final query = rawQuery.trim().toLowerCase();
+    final thisGeneration = ++generation;
+    _cancelScans();
+
+    if (query.isEmpty) {
+      setState(() {
+        results.clear();
+        isSearchingBodies = false;
+        scannedBodies = 0;
+        totalBodies = 0;
+      });
+      return;
+    }
+
+    final titleMatches = <NoteSearchResult>[];
+    final bodyCandidates = <String>[];
+    for (final filePath in allFiles) {
+      final title = filePath.substring(filePath.lastIndexOf('/') + 1);
+      if (title.toLowerCase().contains(query)) {
+        titleMatches.add(NoteSearchResult(_withoutExtension(filePath), null));
+      } else {
+        bodyCandidates.add(filePath);
+      }
+    }
+
+    setState(() {
+      _setResults(titleMatches);
+      scannedBodies = 0;
+      totalBodies = titleOnly ? 0 : bodyCandidates.length;
+      isSearchingBodies = !titleOnly && bodyCandidates.isNotEmpty;
+    });
+
+    if (titleOnly || bodyCandidates.isEmpty) return;
+    await _searchBodies(
+      thisGeneration: thisGeneration,
+      query: query,
+      titleMatches: titleMatches,
+      candidates: bodyCandidates,
+    );
+  }
+
+  Future<void> _searchBodies({
+    required int thisGeneration,
+    required String query,
+    required List<NoteSearchResult> titleMatches,
+    required List<String> candidates,
+  }) async {
+    final bodyMatches = <NoteSearchResult>[];
+    var next = 0;
+    var done = 0;
+    var shownResults = 0;
+
+    Future<void> worker() async {
+      while (thisGeneration == generation && next < candidates.length) {
+        final filePath = candidates[next];
+        next++;
+
+        final scan = NoteSearch.readPlainText(filePath);
+        runningScans.add(scan);
+
+        String? text;
+        try {
+          text = await scan;
+        } on CanceledError {
+          return;
+        } catch (_) {
+          text = null;
+        }
+        if (thisGeneration != generation) return;
+
+        done++;
+        if (text != null) {
+          final snippet = NoteSearch.makeSnippet(text, query);
+          if (snippet != null) {
+            bodyMatches.add(
+              NoteSearchResult(_withoutExtension(filePath), snippet),
+            );
+          }
+        }
+
+        final isFinished = done == candidates.length;
+        final hasNewResults = bodyMatches.length != shownResults;
+        if (mounted && (hasNewResults || isFinished || done % 4 == 0)) {
+          shownResults = bodyMatches.length;
+          setState(() {
+            _setResults([...titleMatches, ...bodyMatches]);
+            scannedBodies = done;
+          });
+        }
+      }
+    }
+
+    await Future.wait([
+      for (int i = 0; i < _scanConcurrency; i++) worker(),
+    ]);
+    _cancelScans();
+    if (thisGeneration != generation || !mounted) return;
+
+    setState(() {
+      isSearchingBodies = false;
+      scannedBodies = candidates.length;
+      _setResults([...titleMatches, ...bodyMatches]);
+    });
+  }
+
+  String _withoutExtension(String filePath) {
+    for (final extension in ['.sbn2', '.sbn']) {
+      if (filePath.endsWith(extension)) {
+        return filePath.substring(0, filePath.length - extension.length);
+      }
+    }
+    return filePath;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final query = queryController.text.trim();
+
+    return Scaffold(
+      appBar: AppBar(
+        title: TextField(
+          controller: queryController,
+          autofocus: true,
+          textInputAction: .search,
+          decoration: const InputDecoration(
+            border: .none,
+            // 个人自用版：未走 i18n
+            hintText: '搜索笔记标题与正文',
+          ),
+        ),
+        actions: [
+          if (query.isNotEmpty)
+            IconButton(
+              tooltip: '清除', // 个人自用版：未走 i18n
+              onPressed: queryController.clear,
+              icon: const Icon(Icons.close),
+            ),
+          const SizedBox(width: 8),
+        ],
+      ),
+      body: Column(
+        children: [
+          Padding(
+            padding: const .symmetric(horizontal: 8),
+            child: Row(
+              children: [
+                FilterChip(
+                  // 个人自用版：未走 i18n
+                  label: const Text('仅搜标题'),
+                  selected: titleOnly,
+                  onSelected: (selected) {
+                    setState(() => titleOnly = selected);
+                    search(queryController.text);
+                  },
+                ),
+                const Spacer(),
+                if (isSearchingBodies)
+                  Expanded(
+                    flex: 3,
+                    child: Row(
+                      mainAxisAlignment: .end,
+                      children: [
+                        Flexible(
+                          child: Text(
+                            // 个人自用版：未走 i18n
+                            '正在搜索正文 $scannedBodies/$totalBodies',
+                            style: TextTheme.of(context).bodySmall,
+                            overflow: .ellipsis,
+                          ),
+                        ),
+                        const SizedBox(width: 8),
+                        const SizedBox(
+                          width: 90,
+                          child: LinearProgressIndicator(),
+                        ),
+                      ],
+                    ),
+                  ),
+              ],
+            ),
+          ),
+          Expanded(child: _buildBody(query)),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildBody(String query) {
+    if (isLoadingFiles) {
+      return const Center(child: CircularProgressIndicator());
+    }
+    if (query.isEmpty) {
+      // 个人自用版：未走 i18n
+      return const _SearchHint(text: '输入关键字，搜索所有笔记的标题与正文');
+    }
+    if (results.isEmpty && !isSearchingBodies) {
+      // 个人自用版：未走 i18n
+      return const _SearchHint(text: '没有找到匹配的笔记');
+    }
+
+    return ListView.builder(
+      itemCount: results.length,
+      itemBuilder: (context, index) {
+        final result = results[index];
+        return ListTile(
+          leading: const Icon(Icons.article_outlined),
+          title: _HighlightedText(text: result.title, query: query),
+          subtitle: Column(
+            crossAxisAlignment: .start,
+            children: [
+              Text(
+                result.parentDirectory,
+                style: TextTheme.of(context).bodySmall,
+              ),
+              if (result.snippet != null)
+                _HighlightedText(
+                  text: result.snippet!,
+                  query: query,
+                  maxLines: 2,
+                ),
+            ],
+          ),
+          onTap: () => context.push(RoutePaths.editFilePath(result.filePath)),
+        );
+      },
+    );
+  }
+}
+
+class const _SearchHint({required final String text}) extends StatelessWidget {
+  @override
+  Widget build(BuildContext context) {
+    return Center(
+      child: Padding(
+        padding: const .all(32),
+        child: Text(
+          text,
+          textAlign: .center,
+          style: TextTheme.of(context).bodyLarge?.copyWith(
+            color: ColorScheme.of(context).onSurfaceVariant,
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// 个人自用版：把 [query] 的命中部分加粗高亮。
+class const _HighlightedText({
+  required final String text,
+  required final String query,
+  final int maxLines = 1,
+}) extends StatelessWidget {
+  @override
+  Widget build(BuildContext context) {
+    final index = text.toLowerCase().indexOf(query.toLowerCase());
+    if (index == -1) {
+      return Text(text, maxLines: maxLines, overflow: .ellipsis);
+    }
+
+    final colorScheme = ColorScheme.of(context);
+    return Text.rich(
+      TextSpan(
+        children: [
+          TextSpan(text: text.substring(0, index)),
+          TextSpan(
+            text: text.substring(index, index + query.length),
+            style: TextStyle(color: colorScheme.primary, fontWeight: .bold),
+          ),
+          TextSpan(text: text.substring(index + query.length)),
+        ],
+      ),
+      maxLines: maxLines,
+      overflow: .ellipsis,
+    );
+  }
+}
