+import 'package:flutter/material.dart';
+import 'package:go_router/go_router.dart';
+import 'package:intl/intl.dart';
+import 'package:saber/data/file_manager/file_manager.dart';
+import 'package:saber/data/routes.dart';
+import 'package:saber/pages/editor/editor.dart';
+
+/// 个人自用版：一键进入今天的每日笔记（未走 i18n，文案直接使用中文字面量）。
+///
+/// If today's note doesn't exist yet, the editor creates it on first save, just
+/// like the existing "new note" button does.
+class const DailyNoteButton({super.key}) extends StatelessWidget {
+  /// 个人自用版：每日笔记存放的文件夹。
+  static const folderName = '每日笔记';
+
+  static final dateFormat = DateFormat('yy-MM-dd');
+
+  /// The relative path (without extension) of today's note.
+  static String todayNotePath([DateTime? now]) {
+    final date = dateFormat.format(now ?? DateTime.now());
+    return '/$folderName/$date';
+  }
+
+  /// Opens today's note, creating its folder if the note doesn't exist yet.
+  static Future<void> openDailyNote(BuildContext context) async {
+    final filePath = todayNotePath();
+
+    final alreadyExists =
+        FileManager.doesFileExist('$filePath${Editor.extension}') ||
+        FileManager.doesFileExist('$filePath${Editor.extensionOldJson}');
+    if (!alreadyExists) {
+      await FileManager.createFolder('/$folderName');
+      if (!context.mounted) return;
+    }
+
+    context.push(RoutePaths.editFilePath(filePath));
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return IconButton(
+      // 个人自用版：未走 i18n
+      tooltip: '今天的每日笔记',
+      onPressed: () => openDailyNote(context),
+      icon: const Icon(Icons.today),
+    );
+  }
+}
