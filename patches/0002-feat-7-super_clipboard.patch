+
+void main() {
+  test('PenPresets round trips through stows.penPresets', () {
+    PenPresets.save([]);
+    expect(PenPresets.load(), isEmpty);
+
+    final saved = PenPresets.add(
+      PenPreset(
+        name: '红笔',
+        toolId: .fountainPen,
+        color: const Color(0xFFD32F2F),
+        pressureEnabled: true,
+        options: StrokeOptions(size: 7, thinning: 0.3),
+      ),
+    );
+
+    expect(saved, isNotNull);
+    expect(saved!.length, 1);
+
+    final loaded = PenPresets.load();
+    expect(loaded.length, 1);
+    expect(loaded.single.name, '红笔');
+    expect(loaded.single.toolId, ToolId.fountainPen);
+    expect(loaded.single.color.toARGB32(), 0xFFD32F2F);
+    expect(loaded.single.pressureEnabled, isTrue);
+    expect(loaded.single.options.size, 7);
+    expect(loaded.single.options.thinning, 0.3);
+  });
+
+  test('PenPresets refuses to save more than PenPreset.maxCount presets', () {
+    PenPresets.save([]);
+
+    for (var i = 0; i < PenPreset.maxCount; i++) {
+      expect(_add('p$i'), isNotNull, reason: 'preset $i should be saved');
+    }
+    expect(PenPresets.load().length, PenPreset.maxCount);
+    expect(_add('too many'), isNull);
+
+    PenPresets.removeAt(0);
+    expect(PenPresets.load(), hasLength(PenPreset.maxCount - 1));
+    expect(_add('p3'), isNotNull);
+  });
+
+  test('PenPresets ignores corrupted data', () {
+    stows.penPresets.value = 'not json';
+    expect(PenPresets.load(), isEmpty);
+
+    stows.penPresets.value = '{"v":1,"presets":[{"t":"nonsense"},42]}';
+    expect(PenPresets.load(), isEmpty);
+  });
+}
+
+PenPreset _preset(String name) => PenPreset(
+  name: name,
+  toolId: .ballpointPen,
+  color: Colors.black,
+  pressureEnabled: false,
+  options: StrokeOptions(size: 3),
+);
+
+List<PenPreset>? _add(String name) => PenPresets.add(_preset(name));
