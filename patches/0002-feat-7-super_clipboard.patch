+    .ballpointPen => Pen.ballpointPenIcon,
+    .shapePen => ShapePen.shapePenIcon,
+    .highlighter => Highlighter.highlighterIcon,
+    .pencil => Pencil.pencilIcon,
+    _ => Pen.fountainPenIcon,
+  };
+
+  void _showMessage(String message) {
+    if (!mounted) return;
