diff --git a/test/editor_text_export_test.dart b/test/editor_text_export_test.dart
new file mode 100644
index 00000000..5e3aabe7
--- /dev/null
+++ b/test/editor_text_export_test.dart
@@ -0,0 +1,139 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_quill/flutter_quill.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:perfect_freehand/perfect_freehand.dart';
+import 'package:saber/components/canvas/_stroke.dart';
+import 'package:saber/data/editor/editor_core_info.dart';
+import 'package:saber/data/editor/editor_exporter.dart';
+import 'package:saber/data/editor/page.dart';
+
+void main() {
+  test('QuillToMarkdown converts the common inline and block styles', () {
+    final markdown = EditorExporter.generateMarkdown(
+      _coreInfoWithDocument(
+        '/Notes/Test',
+        Document.fromJson([
+          {'insert': 'Title'},
+          {
+            'insert': '\n',
+            'attributes': {'header': 1},
+          },
+          {'insert': 'plain '},
+          {
+            'insert': 'bold',
+            'attributes': {'bold': true},
+          },
+          {'insert': ' and '},
+          {
+            'insert': 'italic',
+            'attributes': {'italic': true},
+          },
+          {'insert': ' '},
+          {
+            'insert': 'link',
+            'attributes': {'link': 'https://example.com'},
+          },
+          {'insert': '\n'},
+          {'insert': 'one'},
+          {
+            'insert': '\n',
+            'attributes': {'list': 'ordered'},
+          },
+          {'insert': 'two'},
+          {
+            'insert': '\n',
+            'attributes': {'list': 'bullet'},
+          },
+          {'insert': 'quote'},
+          {
+            'insert': '\n',
+            'attributes': {'blockquote': true},
+          },
+          {'insert': 'code'},
+          {
+            'insert': '\n',
+            'attributes': {'code-block': true},
+          },
+          {'insert': 'print(1)'},
+          {'insert': '\n'},
+          {'insert': 'after'},
+          {'insert': '\n'},
+        ]),
+      ),
+    );
+
+    expect(markdown, startsWith('# Test\n'));
+    expect(markdown, contains('\nplain **bold** and *italic* [link]('));
+    expect(markdown, contains('https://example.com)'));
+    expect(markdown, contains('\n1. one\n'));
+    expect(markdown, contains('\n- two\n'));
+    expect(markdown, contains('\n> quote\n'));
+    expect(markdown, contains('```\ncode\n```\n'));
+    expect(markdown, contains('\nprint(1)\n'));
+    expect(markdown, endsWith('\nafter\n'));
+  });
+
+  test('Exporting text reports handwriting that cannot be converted', () {
+    final coreInfo = EditorCoreInfo(filePath: '/Notes/Doodle');
+    final page = EditorPage();
+    page.strokes.add(
+      Stroke(
+        color: Colors.black,
+        pressureEnabled: false,
+        options: StrokeOptions(size: 5),
+        pageIndex: 0,
+        page: page,
+        toolId: .fountainPen,
+      ),
+    );
+    coreInfo.pages.add(page);
+
+    final markdown = EditorExporter.generateMarkdown(coreInfo);
+    expect(markdown, startsWith('# Doodle\n'));
+    expect(markdown, contains('本笔记含手写/图片内容（共 1 笔、0 张图片）'));
+    expect(markdown, contains('（本页没有文本内容）'));
+    expect(markdown, contains('本页还有 1 笔手写、0 张图片'));
+    expect(markdown, isNot(contains('## 第')));
+
+    final plainText = EditorExporter.generatePlainText(coreInfo);
+    expect(plainText, startsWith('Doodle\n======\n'));
+    expect(plainText, contains('未包含在文本导出中'));
+    expect(plainText, isNot(contains('>')));
+  });
+
+  test('Plain text export has no markdown markup', () {
+    final plainText = EditorExporter.generatePlainText(
+      _coreInfoWithDocument(
+        '/Notes/Plain',
+        Document.fromJson([
+          {'insert': 'Hello '},
+          {
+            'insert': 'world',
+            'attributes': {'bold': true},
+          },
+          {'insert': '\n'},
+        ]),
+      ),
+    );
+
+    expect(plainText, startsWith('Plain\n=====\n'));
+    expect(plainText, contains('Hello world'));
+    expect(plainText, isNot(contains('**')));
+  });
+}
+
+EditorCoreInfo _coreInfoWithDocument(String filePath, Document document) {
+  final coreInfo = EditorCoreInfo(filePath: filePath);
+  coreInfo.pages.add(
+    EditorPage(
+      quill: QuillStruct(
+        controller: QuillController(
+          document: document,
+          selection: const TextSelection.collapsed(offset: 0),
+        ),
+        focusNode: FocusNode(debugLabel: 'Text export test'),
+      ),
+    ),
+  );
+  return coreInfo;
+}
diff --git a/test/pen_presets_test.dart b/test/pen_presets_test.dart
new file mode 100644
index 00000000..b0d90b8d
--- /dev/null
+++ b/test/pen_presets_test.dart
@@ -0,0 +1,67 @@
+import 'package:flutter/material.dart';
