diff --git a/lib/pages/home/trash.dart b/lib/pages/home/trash.dart
new file mode 100644
index 00000000..049be48b
--- /dev/null
+++ b/lib/pages/home/trash.dart
@@ -0,0 +1,181 @@
+import 'package:flutter/material.dart';
+import 'package:intl/intl.dart';
+import 'package:saber/data/file_manager/file_manager.dart';
+
+/// 个人自用版：回收站页面（未走 i18n，文案直接使用中文字面量）。
+class const TrashPage({super.key}) extends StatefulWidget {
+  @override
+  State<TrashPage> createState() => _TrashPageState();
+}
+
+class _TrashPageState extends State<TrashPage> {
+  List<TrashedNote>? notes;
+  var isBusy = false;
+
+  static final dateFormat = DateFormat('yyyy-MM-dd HH:mm');
+
+  @override
+  void initState() {
+    super.initState();
+    refresh();
+  }
+
+  Future<void> refresh() async {
+    final trashedNotes = await FileManager.listTrashedNotes();
+    if (!mounted) return;
+    setState(() => notes = trashedNotes);
+  }
+
+  void showMessage(String message) {
+    ScaffoldMessenger.of(
+      context,
+    ).showSnackBar(SnackBar(content: Text(message)));
+  }
+
+  Future<void> restore(TrashedNote note) async {
+    setState(() => isBusy = true);
+    try {
+      final restoredPath = await FileManager.restoreFromTrash(note.trashPath);
+      await refresh();
+      showMessage('已恢复到 $restoredPath');
+    } catch (e) {
+      showMessage('恢复失败：$e');
+    } finally {
+      if (mounted) setState(() => isBusy = false);
+    }
+  }
+
+  Future<void> deleteForever(TrashedNote note) async {
+    final confirmed = await _confirm(
+      title: '彻底删除这条笔记？',
+      message: '${note.title}\n此操作无法撤销。',
+      confirmLabel: '彻底删除',
+    );
+    if (confirmed != true) return;
+
+    setState(() => isBusy = true);
+    try {
+      await FileManager.permanentlyDeleteFromTrash(note.trashPath);
+      await refresh();
+      showMessage('已彻底删除');
+    } finally {
+      if (mounted) setState(() => isBusy = false);
+    }
+  }
+
+  Future<void> emptyTrash() async {
+    final noteCount = notes?.length ?? 0;
+    final confirmed = await _confirm(
+      title: '清空回收站？',
+      message: '将彻底删除回收站中的 $noteCount 条笔记，此操作无法撤销。',
+      confirmLabel: '清空',
+    );
+    if (confirmed != true) return;
+
+    setState(() => isBusy = true);
+    try {
+      await FileManager.emptyTrash();
+      await refresh();
+      showMessage('回收站已清空');
+    } finally {
+      if (mounted) setState(() => isBusy = false);
+    }
+  }
+
+  Future<bool?> _confirm({
+    required String title,
+    required String message,
+    required String confirmLabel,
+  }) {
+    return showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: Text(title),
+        content: Text(message),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(false),
+            child: const Text('取消'),
+          ),
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(true),
+            child: Text(confirmLabel),
+          ),
+        ],
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final trashedNotes = notes;
+
+    return Scaffold(
+      appBar: AppBar(
+        title: const Text('回收站'),
+        actions: [
+          IconButton(
+            tooltip: '清空回收站',
+            onPressed: (trashedNotes == null || trashedNotes.isEmpty || isBusy)
+                ? null
+                : emptyTrash,
+            icon: const Icon(Icons.delete_sweep),
+          ),
+          const SizedBox(width: 8),
+        ],
+      ),
+      body: switch (trashedNotes) {
+        null => const Center(child: CircularProgressIndicator()),
+        [] => const Center(
+          child: Padding(
+            padding: .all(32),
+            child: Text('回收站是空的', textAlign: .center),
+          ),
+        ),
+        _ => Stack(
+          children: [
+            ListView.separated(
+              padding: const .only(bottom: 32),
+              itemCount: trashedNotes.length,
+              separatorBuilder: (context, index) => const Divider(height: 1),
+              itemBuilder: (context, index) {
+                final note = trashedNotes[index];
+                return ListTile(
+                  leading: const Icon(Icons.restore_from_trash),
+                  title: Text(note.title, maxLines: 1, overflow: .ellipsis),
+                  subtitle: Text(
+                    '原位置：${note.parentDirectory}\n'
+                    '删除于：${dateFormat.format(note.deletedAt)}',
+                  ),
+                  isThreeLine: true,
+                  trailing: Row(
+                    mainAxisSize: .min,
+                    children: [
+                      IconButton(
+                        tooltip: '恢复',
+                        onPressed: isBusy ? null : () => restore(note),
+                        icon: const Icon(Icons.restore),
+                      ),
+                      IconButton(
+                        tooltip: '彻底删除',
+                        onPressed: isBusy ? null : () => deleteForever(note),
+                        icon: const Icon(Icons.delete_forever),
+                      ),
+                    ],
+                  ),
+                );
+              },
+            ),
+            if (isBusy)
+              const Positioned(
+                top: 0,
+                left: 0,
+                right: 0,
+                child: LinearProgressIndicator(),
+              ),
+          ],
+        ),
+      },
+    );
+  }
+}
