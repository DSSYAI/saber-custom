+            ),
+          ],
+        );
+      },
+    );
+  }
+}
+
+class _PresetButton extends StatelessWidget {
+  const new({
+    required this.preset,
+    required this.icon,
+    required this.onTap,
+    required this.onDelete,
+  });
+
+  final PenPreset preset;
+  /// An [IconData] or [FaIconData], see [UniIcon].
+  final Object icon;
+  final VoidCallback onTap;
+  final VoidCallback onDelete;
+
+  @override
+  Widget build(BuildContext context) {
+    final iconColor = ThemeData.estimateBrightnessForColor(preset.color) == .dark
+        ? Colors.white
+        : Colors.black;
+
+    return Tooltip(
+      // 个人自用版：未走 i18n
+      message: '${preset.name}\n点击应用，长按删除',
+      child: InkWell(
+        onTap: onTap,
+        onLongPress: onDelete,
+        customBorder: const CircleBorder(),
+        child: SizedBox.square(
+          dimension: 32,
+          child: DecoratedBox(
+            decoration: BoxDecoration(
+              color: preset.color,
+              shape: .circle,
+              border: Border.all(color: ColorScheme.of(context).outline),
+            ),
+            child: Center(child: UniIcon(icon, size: 15, color: iconColor)),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+class _SavePresetDialog extends StatefulWidget {
+  const new({required this.initialName});
+
+  final String initialName;
+
+  @override
+  State<_SavePresetDialog> createState() => _SavePresetDialogState();
+}
+
+class _SavePresetDialogState extends State<_SavePresetDialog> {
+  late final controller = TextEditingController(text: widget.initialName);
+
+  @override
+  void dispose() {
+    controller.dispose();
+    super.dispose();
+  }
+
+  void _submit() {
+    final name = controller.text.trim();
+    Navigator.pop(context, name.isEmpty ? widget.initialName : name);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return AdaptiveAlertDialog(
+      // 个人自用版：未走 i18n
+      title: const Text('保存笔预设'),
+      content: TextField(
+        controller: controller,
+        autofocus: true,
+        // 个人自用版：未走 i18n
+        decoration: const InputDecoration(labelText: '预设名称'),
+        onSubmitted: (_) => _submit(),
+      ),
+      actions: [
+        CupertinoDialogAction(
+          onPressed: () => Navigator.pop(context),
+          // 个人自用版：未走 i18n
+          child: const Text('取消'),
+        ),
+        CupertinoDialogAction(
+          onPressed: _submit,
+          // 个人自用版：未走 i18n
+          child: const Text('保存'),
+        ),
+      ],
+    );
+  }
+}
