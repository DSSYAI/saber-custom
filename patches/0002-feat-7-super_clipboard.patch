index 00000000..2443596d
--- /dev/null
+++ b/lib/data/editor/quill_to_markdown.dart
@@ -0,0 +1,184 @@
+import 'package:flutter_quill/flutter_quill.dart';
+
+/// Converts a Quill [Document] into Markdown.
+///
+/// Note: flutter_quill 11.5.1 does ship a `DeltaToMarkdown` converter, but it
+/// isn't exported from `package:flutter_quill/flutter_quill.dart`; it only
+/// lives in `src/packages/quill_markdown/`, so using it would mean an
+/// implementation import of a private path. This is a small, self-contained
+/// replacement which additionally degrades embeds (images, videos, ...) into
+/// readable placeholders instead of silently dropping them.
+///
+/// Supported: headers, bold, italic, underline, strikethrough, inline code,
+/// code blocks, block quotes, ordered/bullet/checkbox lists, indentation,
+/// sub/superscript and links. Fonts, sizes, colors and alignments have no
+/// Markdown equivalent and are dropped.
+abstract class QuillToMarkdown {
+  /// Converts [document] into a Markdown string,
+  /// without leading or trailing blank lines.
+  static String convert(Document document) {
+    final out = StringBuffer();
+
+    /// The inline segments of the line currently being written.
+    final segments = <({String text, Map<String, dynamic>? attributes})>[];
+
+    /// Whether we're inside a fenced code block, so that blank lines and
+    /// inline formatting are written verbatim.
+    var inCodeBlock = false;
+
+    void flushLine(Map<String, dynamic>? attributes) {
+      final attrs = attributes ?? const <String, dynamic>{};
+      final codeBlock = attrs['code-block'];
+      final isCodeBlock = codeBlock == true || codeBlock is String;
+
+      if (inCodeBlock && !isCodeBlock) {
+        out.writeln('```');
+        inCodeBlock = false;
+      }
+
+      final content = segments
+          .map(
+            (segment) => isCodeBlock
+                ? segment.text
+                : _inline(segment.text, segment.attributes),
+          )
+          .join();
+      segments.clear();
+
+      if (isCodeBlock) {
+        if (!inCodeBlock) {
+          final language = codeBlock is String && codeBlock != 'true'
+              ? codeBlock
+              : '';
+          out.writeln('```$language');
+          inCodeBlock = true;
+        }
+        out.writeln(content);
+        return;
+      }
+
+      final line = '${_blockPrefix(attrs)}$content'.trimRight();
+      if (line.isEmpty) {
+        out.writeln();
+      } else {
+        out.writeln(line);
+      }
+    }
+
+    for (final operation in document.toDelta().operations) {
+      final attributes = operation.attributes;
+      final data = operation.data;
+      if (data is String) {
+        var start = 0;
+        while (true) {
+          final newlineIndex = data.indexOf('\n', start);
+          if (newlineIndex == -1) break;
+          if (newlineIndex > start) {
+            segments.add((
+              text: data.substring(start, newlineIndex),
+              attributes: attributes,
+            ));
+          }
+          // block attributes are stored on the newline itself
+          flushLine(attributes);
+          start = newlineIndex + 1;
+        }
+        if (start < data.length) {
+          segments.add((text: data.substring(start), attributes: attributes));
+        }
+      } else if (data is Map) {
+        segments.add((text: _embedToMarkdown(data), attributes: attributes));
+      }
+    }
+    // the document usually ends with a newline, but not always
+    if (segments.isNotEmpty) flushLine(null);
+    if (inCodeBlock) out.writeln('```');
+
+    return out
+        .toString()
+        .replaceFirst(RegExp(r'^\n+'), '')
+        .trimRight();
+  }
+
+  /// The Markdown prefix for a line with the given block [attributes],
+  /// e.g. `## ` for a level 2 header or `- ` for a bullet list item.
+  static String _blockPrefix(Map<String, dynamic> attributes) {
+    final indent = attributes['indent'];
+    final indentLevel = indent is int ? indent : 0;
+    final indentation = '  ' * indentLevel;
+
+    final header = attributes['header'];
+    if (header is int) {
+      return '${'#' * header.clamp(1, 6).toInt()} ';
+    }
+
+    switch (attributes['list']) {
+      case 'ordered':
+        return '${indentation}1. ';
+      case 'bullet':
+        return '$indentation- ';
+      case 'checked':
+        return '$indentation- [x] ';
+      case 'unchecked':
+        return '$indentation- [ ] ';
+    }
+
+    if (attributes['blockquote'] == true) return '> ';
+    if (indentLevel > 0) return indentation;
+    return '';
+  }
+
+  /// Wraps [text] in the Markdown markers for its inline [attributes].
+  static String _inline(String text, Map<String, dynamic>? attributes) {
+    if (text.isEmpty) return text;
+    if (attributes == null || attributes.isEmpty) return text;
+
+    var result = text;
+
+    // innermost first, so that e.g. bold + italic becomes `***text***`
+    if (attributes['code'] == true) result = '`$result`';
+    if (attributes['bold'] == true) result = '**$result**';
+    if (attributes['italic'] == true) result = '*$result*';
+    if (attributes['strike'] == true) result = '~~$result~~';
+    if (attributes['underline'] == true) result = '<u>$result</u>';
+
+    switch (attributes['script']) {
+      case 'sub':
+        result = '<sub>$result</sub>';
+      case 'super':
+        result = '<sup>$result</sup>';
+    }
+
+    // outermost, so that a link can contain formatted text
+    final href = _linkHref(attributes['link']);
+    if (href != null && href.isNotEmpty) result = '[$result]($href)';
+
+    return result;
+  }
+
+  /// Quill stores a link either as a plain string, or as a map (in newer
+  /// versions, e.g. `{"href": "...", "text": "..."}`).
+  static String? _linkHref(Object? link) {
+    if (link is String) return link;
+    if (link is Map) {
+      final href = link['href'];
+      if (href is String) return href;
+    }
+    return null;
+  }
+
+  /// Embeds (images, videos, ...) can't be represented in Markdown,
+  /// so they're replaced with a placeholder that says what was there.
+  static String _embedToMarkdown(Map<dynamic, dynamic> data) {
+    if (data.containsKey('image')) {
+      final src = data['image'];
+      if (src is String && src.isNotEmpty) {
+        return '![图片：内嵌资源，无法导出到文本]($src)';
+      }
+      return '![图片：内嵌资源，无法导出到文本]';
+    }
+    if (data.containsKey('video')) return '[视频：无法导出到文本]';
+    if (data.containsKey('file')) return '[附件：无法导出到文本]';
+    return '[嵌入内容：无法导出到文本]';
+  }
+}
