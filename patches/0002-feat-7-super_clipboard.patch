diff --git a/lib/components/toolbar/editor_info_section.dart b/lib/components/toolbar/editor_info_section.dart
new file mode 100644
index 00000000..e60f8835
--- /dev/null
+++ b/lib/components/toolbar/editor_info_section.dart
@@ -0,0 +1,160 @@
+import 'package:flutter/material.dart';
+import 'package:intl/intl.dart';
+import 'package:saber/data/editor/editor_core_info.dart';
+import 'package:saber/data/file_manager/file_manager.dart';
+import 'package:saber/pages/editor/editor.dart';
+
+/// 个人自用版：编辑器底部面板中的「笔记信息」区块。
+///
+/// Shows a few cheap statistics about the note. All of them come from data
+/// that's already in memory, except the file size and the last modified time,
+/// which are read from disk once when the panel is opened.
+class EditorInfoSection extends StatefulWidget {
+  const new({super.key, required this.coreInfo});
+
+  final EditorCoreInfo coreInfo;
+
+  @override
+  State<EditorInfoSection> createState() => _EditorInfoSectionState();
+}
+
+class _EditorInfoSectionState extends State<EditorInfoSection> {
+  static final _whitespace = RegExp(r'\s');
+
+  late final int pageCount;
+  late final int strokeCount;
+  late final int imageCount;
+  late final int characterCount;
+
+  /// The size of the saved file, and when it was last modified.
+  /// [modified] is null if the note has never been saved.
+  late final ({int size, DateTime? modified}) fileStats;
+
+  @override
+  void initState() {
+    super.initState();
+
+    pageCount = widget.coreInfo.pages.length;
+
+    var strokes = 0;
+    var images = 0;
+    var characters = 0;
+    for (final page in widget.coreInfo.pages) {
+      strokes += page.strokes.length;
+      images += page.images.length + (page.backgroundImage == null ? 0 : 1);
+      // the character count only covers typed text, not handwriting
+      characters += page.quill.controller.document
+          .toPlainText()
+          .replaceAll(_whitespace, '')
+          .length;
+    }
+    strokeCount = strokes;
+    imageCount = images;
+    characterCount = characters;
+
+    fileStats = _readFileStats();
+  }
+
+  ({int size, DateTime? modified}) _readFileStats() {
+    final filePath = widget.coreInfo.filePath;
+    // the placeholder core info has no file path yet
+    if (!filePath.startsWith('/')) return (size: 0, modified: null);
+
+    for (final extension in [Editor.extension, Editor.extensionOldJson]) {
+      final file = FileManager.getFile('$filePath$extension');
+      if (!file.existsSync()) continue;
+      return (size: file.lengthSync(), modified: file.lastModifiedSync());
+    }
+    return (size: 0, modified: null);
+  }
+
+  static String _prettyFileSize(int bytes) {
+    if (bytes < 1024) return '$bytes B';
+    final double kilobytes = bytes / 1024;
+    if (kilobytes < 1024) return '${kilobytes.toStringAsFixed(1)} KB';
+    return '${(kilobytes / 1024).toStringAsFixed(2)} MB';
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final textTheme = TextTheme.of(context);
+    final labelStyle = textTheme.bodyMedium?.copyWith(
+      color: ColorScheme.of(context).onSurface.withValues(alpha: 0.7),
+    );
+    final modified = fileStats.modified;
+
+    return Column(
+      crossAxisAlignment: .start,
+      children: [
+        // 个人自用版：未走 i18n
+        Text('笔记信息', style: textTheme.titleMedium),
+        // 个人自用版：未走 i18n
+        Text('字数只统计打字输入的文本，手写内容不计入', style: textTheme.bodyMedium),
+        const SizedBox.square(dimension: 8),
+        _InfoRow(
+          label: '页数',
+          value: '$pageCount',
+          labelStyle: labelStyle,
+        ),
+        _InfoRow(
+          label: '笔画数',
+          value: '$strokeCount',
+          labelStyle: labelStyle,
+        ),
+        _InfoRow(
+          label: '图片数',
+          value: '$imageCount',
+          labelStyle: labelStyle,
+        ),
+        _InfoRow(
+          label: '字数',
+          value: '$characterCount',
+          labelStyle: labelStyle,
+        ),
+        _InfoRow(
+          label: '文件大小',
+          value: _prettyFileSize(fileStats.size),
+          labelStyle: labelStyle,
+        ),
+        _InfoRow(
+          label: '最后修改',
+          value: modified == null
+              ? '（尚未保存）'
+              : DateFormat('yyyy-MM-dd HH:mm').format(modified),
+          labelStyle: labelStyle,
+        ),
+        _InfoRow(
+          label: '笔记格式版本',
+          value: 'sbn2 v${EditorCoreInfo.sbnVersion}',
+          labelStyle: labelStyle,
+        ),
+      ],
+    );
+  }
+}
+
+class _InfoRow extends StatelessWidget {
+  const new({
+    required this.label,
+    required this.value,
+    required this.labelStyle,
+  });
+
+  final String label;
+  final String value;
+  final TextStyle? labelStyle;
+
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: const .symmetric(vertical: 3),
+      child: Row(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          SizedBox(width: 110, child: Text(label, style: labelStyle)),
+          Expanded(child: Text(value)),
+        ],
+      ),
+    );
+  }
+}
