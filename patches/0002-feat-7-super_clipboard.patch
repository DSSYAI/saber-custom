@@ -0,0 +1,46 @@
+import 'package:flutter/material.dart';
+import 'package:saber/data/file_manager/pinned_notes.dart';
+import 'package:saber/data/prefs.dart';
+
+/// 个人自用版：笔记卡片角上的置顶/取消置顶按钮（未走 i18n）。
+class PinButton extends StatelessWidget {
+  const new({super.key, required this.filePath});
+
+  /// The note's path, without its extension.
+  final String filePath;
+
+  @override
+  Widget build(BuildContext context) {
+    return ValueListenableBuilder(
+      valueListenable: stows.pinnedFiles,
+      builder: (context, _, _) {
+        final isPinned = PinnedNotes.isPinned(filePath);
+        final colorScheme = ColorScheme.of(context);
+
+        return Tooltip(
+          message: isPinned ? '取消置顶' : '置顶笔记', // 个人自用版：未走 i18n
+          child: Material(
+            color: isPinned
+                ? colorScheme.primaryContainer
+                : colorScheme.surface.withValues(alpha: 0.7),
+            shape: const CircleBorder(),
+            clipBehavior: .antiAlias,
+            child: InkWell(
+              onTap: () => PinnedNotes.setPinned(filePath, pinned: !isPinned),
+              child: Padding(
+                padding: const .all(4),
+                child: Icon(
+                  isPinned ? Icons.push_pin : Icons.push_pin_outlined,
+                  size: 18,
+                  color: isPinned
+                      ? colorScheme.onPrimaryContainer
+                      : colorScheme.onSurfaceVariant,
+                ),
+              ),
+            ),
+          ),
+        );
+      },
+    );
+  }
+}
