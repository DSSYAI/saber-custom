index 00000000..5d7c8565
--- /dev/null
+++ b/lib/data/file_manager/note_search.dart
@@ -0,0 +1,115 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:bson/bson.dart';
+import 'package:flutter/foundation.dart';
+import 'package:saber/data/file_manager/file_manager.dart';
+import 'package:saber/pages/editor/editor.dart';
+import 'package:worker_manager/worker_manager.dart';
+
+/// 个人自用版：笔记全文搜索的底层实现。
+///
+/// Notes are `.sbn2` files (bson), whose pages each store a Quill delta under
+/// the `q` key. Instead of building a whole `EditorCoreInfo` (which would also
+/// parse every stroke and image), this reads only the text of the note, in a
+/// worker isolate so that searching many notes doesn't block the UI.
+abstract class NoteSearch {
+  /// Whether every page of a note is searched, or only its first page.
+  ///
+  /// Reading all pages is more useful but also slower, so this is configurable.
+  static var searchAllPages = true;
+
+  /// Reads [filePath] (a relative note path, with or without its extension)
+  /// and returns its plain text, or `null` if it couldn't be read.
+  ///
+  /// Cancelling the returned [Cancelable] makes the worker stop as soon as it
+  /// can, which is how the search page stays responsive while typing.
+  static Cancelable<String?> readPlainText(String filePath) {
+    final absolutePath = FileManager.getFile(_withExtension(filePath)).path;
+    final isBson = absolutePath.endsWith(Editor.extension);
+
+    return workerManager.executeGentle<String?>((isCanceled) async {
+      if (isCanceled()) return null;
+
+      final bytes = await File(absolutePath).readAsBytes();
+      if (isCanceled()) return null;
+
+      return extractPlainText(bytes: bytes, isBson: isBson);
+    }, priority: WorkPriority.low);
+  }
+
+  static String _withExtension(String filePath) {
+    if (filePath.endsWith(Editor.extension) ||
+        filePath.endsWith(Editor.extensionOldJson)) {
+      return filePath;
+    }
+    if (FileManager.doesFileExist('$filePath${Editor.extensionOldJson}')) {
+      return '$filePath${Editor.extensionOldJson}';
+    }
+    return '$filePath${Editor.extension}';
+  }
+
+  /// Extracts the text of a note from the raw contents of its file.
+  ///
+  /// This runs inside a worker isolate, so it must not touch any state of the
+  /// main isolate.
+  @visibleForTesting
+  static String? extractPlainText({
+    required Uint8List bytes,
+    required bool isBson,
+  }) {
+    try {
+      final dynamic json = isBson
+          ? BsonCodec.deserialize(BsonBinary.from(bytes))
+          : jsonDecode(utf8.decode(bytes));
+      return _plainTextOfJson(json);
+    } catch (_) {
+      return null;
+    }
+  }
+
+  static String _plainTextOfJson(dynamic json) {
+    // The oldest format is just a list of strokes, which has no text.
+    if (json is! Map) return '';
+
+    final buffer = StringBuffer();
+    final pages = json['z'];
+    if (pages is! List) return '';
+
+    for (final page in pages) {
+      if (page is! Map) continue;
+      final delta = page['q'];
+      if (delta is! List) continue;
+
+      for (final op in delta) {
+        if (op is! Map) continue;
+        final insert = op['insert'];
+        if (insert is String) buffer.write(insert);
+      }
+      buffer.write('\n');
+
+      if (!searchAllPages) break;
+    }
+
+    return buffer.toString();
+  }
+
+  /// Returns a short snippet of [text] around the first occurrence of [query],
+  /// or `null` if [text] doesn't contain [query].
+  static String? makeSnippet(String text, String query, {int context = 30}) {
+    final index = text.toLowerCase().indexOf(query.toLowerCase());
+    if (index == -1) return null;
+
+    var start = index - context;
+    if (start < 0) start = 0;
+    var end = index + query.length + context;
+    if (end > text.length) end = text.length;
+
+    final snippet = text
+        .substring(start, end)
+        .replaceAll(RegExp(r'\s+'), ' ')
+        .trim();
+
+    return '${start > 0 ? '…' : ''}$snippet${end < text.length ? '…' : ''}';
+  }
+}
