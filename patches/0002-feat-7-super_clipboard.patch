+import 'package:saber/data/file_manager/file_manager.dart';
+import 'package:saber/data/prefs.dart';
+import 'package:saber/pages/editor/editor.dart';
+
+/// 个人自用版：收藏（置顶）笔记的工具函数。
+///
+/// [stows.pinnedFiles] stores relative paths *with* their extension
+/// (e.g. `/Notes/foo.sbn2`), just like [stows.recentFiles]. Some places in the
+/// app refer to notes without the extension (e.g. `PreviewCard.filePath`), so
+/// always go through this class to convert between the two forms.
+abstract class PinnedNotes {
+  /// Converts a note path that may or may not include its extension into the
+  /// form used by [stows.pinnedFiles].
+  static String withExtension(String filePath) {
+    if (filePath.endsWith(Editor.extension) ||
+        filePath.endsWith(Editor.extensionOldJson)) {
+      return filePath;
+    }
+    if (FileManager.doesFileExist('$filePath${Editor.extensionOldJson}')) {
+      return '$filePath${Editor.extensionOldJson}';
+    }
+    return '$filePath${Editor.extension}';
+  }
+
+  /// Removes the file extension from a note path.
+  static String withoutExtension(String filePath) {
+    if (filePath.endsWith(Editor.extension)) {
+      return filePath.substring(0, filePath.length - Editor.extension.length);
+    } else if (filePath.endsWith(Editor.extensionOldJson)) {
+      return filePath.substring(
+        0,
+        filePath.length - Editor.extensionOldJson.length,
+      );
+    }
+    return filePath;
+  }
+
+  /// Whether the note at [filePath] is pinned (filePath may omit its extension).
+  static bool isPinned(String filePath) {
+    final path = withExtension(filePath);
+    return stows.pinnedFiles.value.contains(path);
+  }
+
+  /// Pins or unpins the note at [filePath].
+  static void setPinned(String filePath, {required bool pinned}) {
+    final path = withExtension(filePath);
+    stows.pinnedFiles.value.remove(path);
+    if (pinned) {
+      // newest pin first, so it's easy to find at the top of the home page
+      stows.pinnedFiles.value.insert(0, path);
+    }
+    stows.pinnedFiles.notifyListeners();
+  }
+
+  /// Pins the note if it isn't pinned, and unpins it otherwise.
+  static void togglePinned(String filePath) {
+    setPinned(filePath, pinned: !isPinned(filePath));
+  }
+
+  /// Pinned notes that still exist, without their extension, in display order.
+  static List<String> existingPinnedNotes() {
+    final result = <String>[];
+    for (final path in stows.pinnedFiles.value) {
+      final withoutExt = withoutExtension(path);
+      if (result.contains(withoutExt)) continue;
+      if (!FileManager.doesFileExist('$withoutExt${Editor.extension}') &&
+          !FileManager.doesFileExist('$withoutExt${Editor.extensionOldJson}')) {
+        continue;
+      }
+      result.add(withoutExt);
+    }
+    return result;
+  }
+}
