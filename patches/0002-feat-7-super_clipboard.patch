+/// ```json
+/// {"v": 1, "presets": [
+///   {"n": "name", "t": "fountainPen", "c": 4278190080,
+///    "p": true, "o": {"s": 5}}
+/// ]}
+/// ```
+@immutable
+class PenPreset {
+  const new({
+    required this.name,
+    required this.toolId,
+    required this.color,
+    required this.pressureEnabled,
+    required this.options,
+  });
+
+  /// The maximum number of presets the user can save.
+  static const maxCount = 3;
+
+  /// The tools that can be saved as a preset.
+  /// Note that [ToolId] itself must not be modified,
+  /// since its values are stored in `.sbn2` files.
+  static const savableToolIds = [
+    ToolId.fountainPen,
+    ToolId.ballpointPen,
+    ToolId.shapePen,
+    ToolId.highlighter,
+    ToolId.pencil,
+  ];
+
+  final String name;
+  final ToolId toolId;
+  final Color color;
+  final bool pressureEnabled;
+  final StrokeOptions options;
+
+  double get size => options.size;
+
+  Map<String, dynamic> toJson() => {
+    'n': name,
+    't': toolId.id,
+    'c': color.toARGB32(),
+    'p': pressureEnabled,
+    'o': options.toJson(),
+  };
+
+  /// Returns null if [json] isn't a valid preset.
+  static PenPreset? fromJson(Map<String, dynamic> json) {
+    ToolId? toolId;
+    for (final candidate in savableToolIds) {
+      if (candidate.id == json['t']) {
+        toolId = candidate;
+        break;
+      }
+    }
+    final color = json['c'];
+    final options = json['o'];
+    if (toolId == null || color is! int || options is! Map) return null;
+
+    final name = json['n'];
+    return PenPreset(
+      name: name is String && name.isNotEmpty ? name : toolId.id,
+      toolId: toolId,
+      color: Color(color),
+      pressureEnabled: json['p'] == true,
+      options: StrokeOptions.fromJson(Map<String, dynamic>.from(options)),
+    );
+  }
+}
+
+/// 个人自用版：读写 [stows.penPresets] 里的笔预设。
+abstract class PenPresets {
+  static final log = Logger('PenPresets');
+
+  static const _version = 1;
+
+  /// The user's saved presets, in display order.
+  /// Never throws: invalid or corrupted data is treated as "no presets".
+  static List<PenPreset> load() {
+    final json = stows.penPresets.value;
+    if (json.isEmpty) return [];
+
+    try {
+      final decoded = jsonDecode(json);
+      if (decoded is! Map) return [];
+      final presets = decoded['presets'];
+      if (presets is! List) return [];
+
+      final result = <PenPreset>[];
+      for (final preset in presets) {
+        if (preset is! Map) continue;
+        final parsed = PenPreset.fromJson(Map<String, dynamic>.from(preset));
+        if (parsed != null && result.length < PenPreset.maxCount) {
+          result.add(parsed);
+        }
+      }
+      return result;
+    } catch (e, st) {
+      log.warning('Failed to parse pen presets', e, st);
+      return [];
+    }
+  }
+
+  static void save(List<PenPreset> presets) {
+    stows.penPresets.value = jsonEncode({
+      'v': _version,
+      'presets': presets.map((preset) => preset.toJson()).toList(),
+    });
+  }
+
+  /// Saves [preset], unless [PenPreset.maxCount] presets are already saved.
+  /// Returns the new list of presets, or null if the limit was reached.
+  static List<PenPreset>? add(PenPreset preset) {
+    final presets = load();
+    if (presets.length >= PenPreset.maxCount) return null;
+
+    presets.add(preset);
+    save(presets);
+    return presets;
+  }
+
+  static void removeAt(int index) {
+    final presets = load();
+    if (index < 0 || index >= presets.length) return;
+
+    presets.removeAt(index);
+    save(presets);
+  }
+
+  /// A snapshot of [pen]'s current settings.
+  static PenPreset fromPen(Pen pen, {required String name}) => PenPreset(
+    name: name,
+    toolId: pen.toolId,
+    color: pen.color,
+    pressureEnabled: pen.pressureEnabled,
+    // snapshot the options, so that later changes to [pen] don't change the preset
+    options: StrokeOptions.fromJson(pen.options.toJson()),
+  );
+
+  /// Returns a default name for a preset saved from [pen],
+  /// e.g. `钢笔 5`.
+  static String suggestName(Pen pen) {
+    final size = pen.options.size;
+    final prettySize = size == size.roundToDouble()
+        ? size.round().toString()
+        : size.toStringAsFixed(1);
+    return '${pen.name} $prettySize';
+  }
+
+  /// Creates (but doesn't select) the tool described by [preset],
+  /// and remembers it as the last used settings of that tool.
+  static Pen createPen(PenPreset preset) {
+    final Pen pen;
+    switch (preset.toolId) {
+      case .ballpointPen:
+        pen = Pen.ballpointPen();
+      case .shapePen:
+        pen = ShapePen();
+      case .highlighter:
+        pen = Highlighter();
+      case .pencil:
+        pen = Pencil();
+      case .fountainPen:
+      case .eraser:
+      case .select:
+      case .textEditing:
+      case .laserPointer:
+        pen = Pen.fountainPen();
+    }
+
+    pen.color = preset.color;
+    pen.pressureEnabled = preset.pressureEnabled;
+
+    // Copy the settings into the existing options object, rather than
+    // replacing it: that object is owned by [stows], which is what makes pen
+    // settings persist between sessions.
+    pen.options.applyFrom(preset.options);
+
+    _saveToPrefs(pen);
+    return pen;
+  }
+
+  /// Writes [pen]'s settings to [stows], so that the preset is remembered
+  /// as the last used settings for its tool.
+  static void _saveToPrefs(Pen pen) {
+    final colorStow = switch (pen.toolId) {
+      .fountainPen => stows.lastFountainPenColor,
+      .ballpointPen => stows.lastBallpointPenColor,
+      .shapePen => stows.lastShapePenColor,
+      .highlighter => stows.lastHighlighterColor,
+      .pencil => stows.lastPencilColor,
+      _ => null,
+    };
+    if (colorStow != null) colorStow.value = pen.color.toARGB32();
+
+    final optionsStow = switch (pen.toolId) {
+      .fountainPen => stows.lastFountainPenOptions,
+      .ballpointPen => stows.lastBallpointPenOptions,
+      .shapePen => stows.lastShapePenOptions,
+      .highlighter => stows.lastHighlighterOptions,
+      .pencil => stows.lastPencilOptions,
+      _ => null,
+    };
+    // the options object was mutated in place, so nothing would be written
+    // to disk without asking the stow to save
+    optionsStow?.notifyListeners();
+  }
+}
+
+extension _StrokeOptionsApplying on StrokeOptions {
+  /// Copies the values of [other] into this instance.
+  void applyFrom(StrokeOptions other) {
+    size = other.size;
+    thinning = other.thinning;
+    smoothing = other.smoothing;
+    streamline = other.streamline;
+    simulatePressure = other.simulatePressure;
+    start
+      ..cap = other.start.cap
+      ..taperEnabled = other.start.taperEnabled
+      ..customTaper = other.start.customTaper;
+    end
+      ..cap = other.end.cap
+      ..taperEnabled = other.end.taperEnabled
+      ..customTaper = other.end.customTaper;
+  }
+}
