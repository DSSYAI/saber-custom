+
+  final Axis axis;
+
+  /// The pen whose settings would be saved as a new preset.
+  final Pen currentPen;
+
+  final void Function(PenPreset preset) applyPreset;
+
+  @override
+  State<PenPresetsBar> createState() => _PenPresetsBarState();
+}
+
+class _PenPresetsBarState extends State<PenPresetsBar> {
+  static const _maxWidth = 132.0;
+
+  static Object _iconFor(ToolId toolId) => switch (toolId) {
