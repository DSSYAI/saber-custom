+import 'dart:typed_data';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:saber/components/canvas/_asset_cache.dart';
+import 'package:saber/components/canvas/image/editor_image.dart';
+
+/// 个人自用版：验证"反色"（`forceInvert`）会被存进笔记、也能读回来。
+///
+/// 这个字段决定图片是否**永远**反色（与主题明暗无关）。它是新加的序列化字段，
+/// 最容易出的问题不是"开关不生效"而是"存了没读回来 / 读回来丢了"，
+/// 所以这里直接做一次 toJson → fromJson 的往返。
+void main() {
+  final bytes = Uint8List.fromList([1, 2, 3, 4]);
+
+  PngEditorImage image({required bool forceInvert}) => PngEditorImage(
+    id: 1,
+    assetCache: AssetCache(),
+    extension: '.png',
+    imageProvider: MemoryImage(bytes),
+    pageIndex: 0,
+    pageSize: .infinite,
+    onMoveImage: null,
+    onDeleteImage: null,
+    onMiscChange: null,
+    forceInvert: forceInvert,
+  );
+
+  EditorImage reload(Map<String, dynamic> json) => EditorImage.fromJson(
+    json,
+    inlineAssets: [bytes],
+    sbnPath: '/Notes/Test',
+    assetCache: AssetCache(),
+  );
+
+  test('forceInvert is written only when set', () {
+    expect(image(forceInvert: true).toJson(OrderedAssetCache())['fi'], isTrue);
+    expect(
+      image(forceInvert: false).toJson(OrderedAssetCache()).containsKey('fi'),
+      isFalse,
+      reason: 'false 时不该写入，免得把每个老笔记都改一遍',
+    );
+  });
+
+  test('forceInvert survives a save/load round trip', () {
+    final json = image(forceInvert: true).toJson(OrderedAssetCache());
+    expect(reload(json).forceInvert, isTrue);
+  });
+
+  test('an image without the field loads as not inverted', () {
+    final json = image(forceInvert: false).toJson(OrderedAssetCache());
+    expect(reload(json).forceInvert, isFalse);
+  });
+
+  test('forceInvert is independent of invertible', () {
+    // invertible 是"深色模式下不要自动反色"的退出开关，两者互不影响
+    final json = image(forceInvert: true).toJson(OrderedAssetCache());
+    final reloaded = reload(json);
+    expect(reloaded.forceInvert, isTrue);
+    expect(reloaded.invertible, isTrue);
+  });
+}
