+  /// 个人自用版：复制一张图片，稍微错开一点叠在原图上。
+  void duplicateImage(EditorImage image) {
+    final copy = image.copy()
+      // id 必须全笔记唯一：CanvasImage 的 key 用到了 id，
+      // 同一页里出现两个相同 id 会撞 key
+      ..id = coreInfo.nextImageId++
+      ..pageIndex = image.pageIndex
+      ..dstRect = image.dstRect.translate(20, 20)
+      ..newImage = true;
+
+    history.recordChange(
+      EditorHistoryItem(
+        type: .draw,
+        pageIndex: image.pageIndex,
+        strokes: [],
+        images: [copy],
+      ),
+    );
+    setState(() {
+      coreInfo.pages[image.pageIndex].images.add(copy);
+    });
+    autosaveAfterDelay();
+  }
+
+  /// 个人自用版：把图片移到最上层（[toFront]）或最下层。
+  ///
+  /// 图片的渲染顺序就是 `page.images` 的顺序，所以改层级就是改下标。
+  void reorderImage(EditorImage image, {required bool toFront}) {
+    final images = coreInfo.pages[image.pageIndex].images;
+    final previous = images.indexOf(image);
+    if (previous < 0) return;
+
+    final target = toFront ? images.length - 1 : 0;
+    if (previous == target) return;
+
+    setState(() => _moveImageToIndex(images, image, target));
+    history.recordChange(
+      EditorHistoryItem(
+        type: .reorderImage,
+        pageIndex: image.pageIndex,
+        strokes: [],
+        images: [image],
+        imageOrderChange: Change(previous: previous, current: target),
+      ),
+    );
+    autosaveAfterDelay();
+  }
+
+  /// 个人自用版：动作条上的复制 / 置顶 / 置底。
+  void onImageAction(EditorImage image, EditorImageAction action) {
+    switch (action) {
+      case .duplicate:
+        duplicateImage(image);
+      case .bringToFront:
+        reorderImage(image, toFront: true);
+      case .sendToBack:
+        reorderImage(image, toFront: false);
+    }
+  }
+
+  static void _moveImageToIndex(
+    List<EditorImage> images,
+    EditorImage image,
+    int index,
+  ) {
+    images.remove(image);
+    images.insert(index.clamp(0, images.length), image);
+  }
+
