diff --git a/lib/components/toolbar/pdf_page_range_dialog.dart b/lib/components/toolbar/pdf_page_range_dialog.dart
new file mode 100644
index 00000000..4238f3bc
--- /dev/null
+++ b/lib/components/toolbar/pdf_page_range_dialog.dart
@@ -0,0 +1,200 @@
+import 'package:flutter/cupertino.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:saber/components/theming/adaptive_alert_dialog.dart';
+import 'package:saber/data/editor/editor_core_info.dart';
+import 'package:saber/data/editor/editor_exporter.dart';
+
+/// 个人自用版：导出 PDF 时选择页码范围（1-based 闭区间）的弹窗。
+///
+/// Asks for a first and a last page number, validates them against the number
+/// of pages [EditorExporter.generatePdf] would actually export, and returns the
+/// chosen range. Returns null if the user cancels.
+class PdfPageRangeDialog extends StatefulWidget {
+  const new({super.key, required this.coreInfo, required this.currentPage});
+
+  final EditorCoreInfo coreInfo;
+
+  /// The 1-based page number currently centred on screen, used by the
+  /// "current page" shortcut. May point past the last exportable page, because
+  /// Saber keeps a blank page at the end of every note.
+  final int currentPage;
+
+  /// Returns the chosen range, or null if the user cancelled.
+  static Future<({int first, int last})?> show(
+    BuildContext context, {
+    required EditorCoreInfo coreInfo,
+    required int currentPage,
+  }) {
+    return showDialog<({int first, int last})>(
+      context: context,
+      builder: (context) => PdfPageRangeDialog(
+        coreInfo: coreInfo,
+        currentPage: currentPage,
+      ),
+    );
+  }
+
+  @override
+  State<PdfPageRangeDialog> createState() => _PdfPageRangeDialogState();
+}
+
+class _PdfPageRangeDialogState extends State<PdfPageRangeDialog> {
+  /// The number of pages that can be exported: the blank page at the end of
+  /// the note doesn't count, matching [EditorExporter.generatePdf].
+  late final int pageCount;
+
+  late final TextEditingController _firstController;
+  late final TextEditingController _lastController;
+
+  @override
+  void initState() {
+    super.initState();
+    pageCount = EditorExporter.pdfExportablePageCount(widget.coreInfo);
+    // default to the whole range, so just pressing "export" does what the
+    // plain PDF button does
+    _firstController = TextEditingController(text: '1');
+    _lastController = TextEditingController(text: '$pageCount');
+  }
+
+  @override
+  void dispose() {
+    _firstController.dispose();
+    _lastController.dispose();
+    super.dispose();
+  }
+
+  /// 个人自用版：未走 i18n
+  String? get _error {
+    if (pageCount <= 0) return null;
+
+    final first = int.tryParse(_firstController.text);
+    final last = int.tryParse(_lastController.text);
+    if (first == null || last == null) return '请输入页码';
+
+    if (first < 1 || last < 1 || first > pageCount || last > pageCount) {
+      return '页码范围 1–$pageCount';
+    }
+
+    if (first > last) return '起始页不能大于结束页';
+
+    return null;
+  }
+
+  void _submit() {
+    final error = _error;
+    if (error != null) return;
+
+    final first = int.tryParse(_firstController.text);
+    final last = int.tryParse(_lastController.text);
+    if (first == null || last == null) return;
+
+    Navigator.pop(context, (first: first, last: last));
+  }
+
+  void _useCurrentPage() {
+    final page = widget.currentPage.clamp(1, pageCount).toInt();
+    setState(() {
+      _firstController.text = '$page';
+      _lastController.text = '$page';
+    });
+  }
+
+  void _useAllPages() {
+    setState(() {
+      _firstController.text = '1';
+      _lastController.text = '$pageCount';
+    });
+  }
+
+  Widget _pageField(TextEditingController controller, String label) {
+    return TextField(
+      controller: controller,
+      keyboardType: TextInputType.number,
+      inputFormatters: [FilteringTextInputFormatter.digitsOnly],
+      decoration: InputDecoration(labelText: label),
+      onChanged: (_) => setState(() {}),
+      onSubmitted: (_) => _submit(),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (pageCount <= 0) {
+      return AdaptiveAlertDialog(
+        // 个人自用版：未走 i18n
+        title: const Text('导出 PDF 选页'),
+        // 个人自用版：未走 i18n
+        content: const Text('这本笔记没有可导出的页。'),
+        actions: [
+          CupertinoDialogAction(
+            onPressed: () => Navigator.pop(context),
+            // 个人自用版：未走 i18n
+            child: const Text('关闭'),
+          ),
+        ],
+      );
+    }
+
+    final error = _error;
+
+    return AdaptiveAlertDialog(
+      // 个人自用版：未走 i18n
+      title: const Text('导出 PDF 选页'),
+      content: SizedBox(
+        width: 320,
+        child: Column(
+          mainAxisSize: .min,
+          crossAxisAlignment: .start,
+          children: [
+            // 个人自用版：未走 i18n
+            Text('共 $pageCount 页（末尾空白页不计）'),
+            const SizedBox.square(dimension: 12),
+            Row(
+              children: [
+                // 个人自用版：未走 i18n
+                Expanded(child: _pageField(_firstController, '起始页')),
+                // 个人自用版：未走 i18n
+                const Padding(
+                  padding: EdgeInsets.symmetric(horizontal: 8),
+                  child: Text('到'),
+                ),
+                // 个人自用版：未走 i18n
+                Expanded(child: _pageField(_lastController, '结束页')),
+              ],
+            ),
+            Row(
+              children: [
+                TextButton(
+                  onPressed: _useCurrentPage,
+                  // 个人自用版：未走 i18n
+                  child: const Text('当前页'),
+                ),
+                TextButton(
+                  onPressed: _useAllPages,
+                  // 个人自用版：未走 i18n
+                  child: const Text('全部'),
+                ),
+              ],
+            ),
+            if (error != null)
+              Text(error, style: TextStyle(color: ColorScheme.of(context).error)),
+          ],
+        ),
+      ),
+      actions: [
+        CupertinoDialogAction(
+          onPressed: () => Navigator.pop(context),
+          // 个人自用版：未走 i18n
+          child: const Text('取消'),
+        ),
+        CupertinoDialogAction(
+          // disabled (onPressed == null) while the range is invalid
+          onPressed: error == null ? _submit : null,
+          // 个人自用版：未走 i18n
+          child: const Text('导出'),
+        ),
+      ],
+    );
+  }
+}
