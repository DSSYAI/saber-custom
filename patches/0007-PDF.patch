+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:perfect_freehand/perfect_freehand.dart';
+import 'package:saber/components/canvas/_stroke.dart';
+import 'package:saber/components/toolbar/pdf_page_range_dialog.dart';
+import 'package:saber/data/editor/editor_core_info.dart';
+import 'package:saber/data/editor/editor_exporter.dart';
+import 'package:saber/data/editor/page.dart';
+
+void main() {
+  group('pdfExportablePageCount', () {
+    test('a blank note has no exportable page', () {
+      expect(EditorExporter.pdfExportablePageCount(_coreInfo([false])), 0);
+      expect(EditorExporter.pdfExportablePageCount(_coreInfo([])), 0);
+    });
+
+    test('the trailing blank page is left out', () {
+      expect(EditorExporter.pdfExportablePageCount(_coreInfo([true, false])), 1);
+      expect(
+        EditorExporter.pdfExportablePageCount(_coreInfo([true, true, false])),
+        2,
+      );
+    });
+
+    test('blank pages in the middle are still exported', () {
+      // only the *last* page is left out, matching EditorExporter.generatePdf
+      expect(
+        EditorExporter.pdfExportablePageCount(_coreInfo([true, false, true])),
+        3,
+      );
+      expect(
+        EditorExporter.pdfExportablePageCount(
+          _coreInfo([true, false, true, false]),
+        ),
+        3,
+      );
+    });
+  });
+
+  group('pdfPageRange', () {
+    test('defaults to the whole note', () {
+      final coreInfo = _coreInfo([true, true, true, false]);
+      expect(EditorExporter.pdfPageRange(coreInfo), (first: 1, last: 3));
+    });
+
+    test('first page only and last page only', () {
+      final coreInfo = _coreInfo([true, true, true, false]);
+      expect(
+        EditorExporter.pdfPageRange(coreInfo, firstPage: 2),
+        (first: 2, last: 3),
+      );
+      expect(
+        EditorExporter.pdfPageRange(coreInfo, lastPage: 2),
+        (first: 1, last: 2),
+      );
+    });
+
+    test('an inner range is kept as-is', () {
+      final coreInfo = _coreInfo([true, true, true, true, true, false]);
+      expect(
+        EditorExporter.pdfPageRange(coreInfo, firstPage: 2, lastPage: 4),
+        (first: 2, last: 4),
+      );
+    });
+
+    test('out of range values are clamped', () {
+      final coreInfo = _coreInfo([true, true, true, false]);
+      expect(
+        EditorExporter.pdfPageRange(coreInfo, firstPage: -5, lastPage: 99),
+        (first: 1, last: 3),
+      );
+      expect(
+        EditorExporter.pdfPageRange(coreInfo, firstPage: 0, lastPage: 0),
+        (first: 1, last: 1),
+      );
+    });
+
+    test('a reversed range is invalid', () {
+      final coreInfo = _coreInfo([true, true, true, false]);
+      expect(
+        EditorExporter.pdfPageRange(coreInfo, firstPage: 3, lastPage: 1),
+        isNull,
+      );
+    });
+
+    test('a single page note can export its only page', () {
+      final coreInfo = _coreInfo([true, false]);
+      expect(
+        EditorExporter.pdfPageRange(coreInfo, firstPage: 1, lastPage: 1),
+        (first: 1, last: 1),
+      );
+    });
+
+    test('the trailing blank page is never selectable', () {
+      // 2 exportable pages, plus the blank one Saber appends
+      final coreInfo = _coreInfo([true, true, false]);
+      expect(EditorExporter.pdfPageRange(coreInfo, lastPage: 99)?.last, 2);
+      expect(
+        EditorExporter.pdfPageRange(coreInfo, firstPage: 3, lastPage: 3),
+        (first: 2, last: 2),
+      );
+    });
+
+    test('a note with nothing to export has no range', () {
+      expect(EditorExporter.pdfPageRange(_coreInfo([false])), isNull);
+      expect(EditorExporter.pdfPageRange(_coreInfo([])), isNull);
+    });
+  });
+
+  group('PdfPageRangeDialog', () {
+    testWidgets('defaults to the whole note and returns it', (tester) async {
+      final result = await _openDialog(
+        tester,
+        _coreInfo([true, true, true, false]),
+        currentPage: 1,
+      );
+
+      expect(find.text('共 3 页（末尾空白页不计）'), findsOneWidget);
+
+      await tester.tap(_exportButton);
+      await tester.pumpAndSettle();
+
+      expect(result.range, (first: 1, last: 3));
+    });
+
+    testWidgets('rejects a reversed range until it is fixed', (tester) async {
+      final result = await _openDialog(
+        tester,
+        _coreInfo([true, true, true, false]),
+        currentPage: 1,
+      );
+
+      await _enterRange(tester, first: '3', last: '1');
+      expect(find.text('起始页不能大于结束页'), findsOneWidget);
+      expect(tester.widget<TextButton>(_exportButton).onPressed, isNull);
+
+      await _enterRange(tester, first: '3', last: '3');
+      expect(find.text('起始页不能大于结束页'), findsNothing);
+      expect(tester.widget<TextButton>(_exportButton).onPressed, isNotNull);
+
+      await tester.tap(_exportButton);
+      await tester.pumpAndSettle();
+
+      expect(result.range, (first: 3, last: 3));
+    });
+
+    testWidgets('rejects pages outside the note', (tester) async {
+      final result = await _openDialog(
+        tester,
+        _coreInfo([true, true, true, false]),
+        currentPage: 1,
+      );
+
+      await _enterRange(tester, first: '1', last: '99');
+      expect(find.text('页码范围 1–3'), findsOneWidget);
+      expect(tester.widget<TextButton>(_exportButton).onPressed, isNull);
+
+      await _enterRange(tester, first: '', last: '2');
+      expect(find.text('请输入页码'), findsOneWidget);
+      expect(tester.widget<TextButton>(_exportButton).onPressed, isNull);
+
+      await tester.tap(find.widgetWithText(TextButton, '取消'));
+      await tester.pumpAndSettle();
+      expect(result.range, isNull);
+    });
+
+    testWidgets('the shortcuts fill in the current page and the whole note', (
+      tester,
+    ) async {
+      final result = await _openDialog(
+        tester,
+        _coreInfo([true, true, true, false]),
+        currentPage: 2,
+      );
+
+      await tester.tap(find.widgetWithText(TextButton, '当前页'));
+      await tester.pump();
+      await tester.tap(_exportButton);
+      await tester.pumpAndSettle();
+      expect(result.range, (first: 2, last: 2));
+
+      // 全部 restores the default
+      await tester.tap(find.text('open'));
+      await tester.pumpAndSettle();
+      await tester.tap(find.widgetWithText(TextButton, '全部'));
+      await tester.pump();
+      await tester.tap(_exportButton);
+      await tester.pumpAndSettle();
+      expect(result.range, (first: 1, last: 3));
+    });
+
+    testWidgets('clamps the current page shortcut to the last exportable page', (
+      tester,
+    ) async {
+      // the blank page at the end is on screen, so currentPage points past it
+      final result = await _openDialog(
+        tester,
+        _coreInfo([true, true, false]),
+        currentPage: 3,
+      );
+
+      await tester.tap(find.widgetWithText(TextButton, '当前页'));
+      await tester.pump();
+      await tester.tap(_exportButton);
+      await tester.pumpAndSettle();
+
+      expect(result.range, (first: 2, last: 2));
+    });
+
+    testWidgets('a blank note cannot export anything', (tester) async {
+      final result = await _openDialog(
+        tester,
+        _coreInfo([false]),
+        currentPage: 1,
+      );
+
+      expect(find.text('这本笔记没有可导出的页。'), findsOneWidget);
+      expect(find.widgetWithText(TextButton, '导出'), findsNothing);
+
+      await tester.tap(find.widgetWithText(TextButton, '关闭'));
+      await tester.pumpAndSettle();
+      expect(result.range, isNull);
+    });
+  });
+}
+
+/// The dialog's confirm button.
+Finder get _exportButton => find.widgetWithText(TextButton, '导出');
+
+Future<void> _enterRange(
+  WidgetTester tester, {
+  required String first,
+  required String last,
+}) async {
+  await tester.enterText(find.byType(TextField).at(0), first);
+  await tester.enterText(find.byType(TextField).at(1), last);
+  await tester.pump();
+}
+
+/// Opens [PdfPageRangeDialog] through a button, and returns a holder that gets
+/// filled in once the dialog closes.
+Future<_DialogResult> _openDialog(
+  WidgetTester tester,
+  EditorCoreInfo coreInfo, {
+  required int currentPage,
+}) async {
+  final result = _DialogResult();
+  await tester.pumpWidget(
+    MaterialApp(
+      home: Scaffold(
+        body: Builder(
+          builder: (context) => TextButton(
+            onPressed: () async {
+              result.range = await PdfPageRangeDialog.show(
+                context,
+                coreInfo: coreInfo,
+                currentPage: currentPage,
+              );
+            },
+            child: const Text('open'),
+          ),
+        ),
+      ),
+    ),
+  );
+
+  await tester.tap(find.text('open'));
+  await tester.pumpAndSettle();
+  return result;
+}
+
+class _DialogResult {
+  ({int first, int last})? range;
+}
+
+/// Builds a note with one page per entry of [hasContent]; `false` means blank.
+EditorCoreInfo _coreInfo(List<bool> hasContent) {
+  final coreInfo = EditorCoreInfo(filePath: '/Notes/Test');
+  for (var pageIndex = 0; pageIndex < hasContent.length; pageIndex++) {
+    final page = EditorPage();
+    if (hasContent[pageIndex]) {
+      page.strokes.add(
+        Stroke(
+          color: Colors.black,
+          pressureEnabled: false,
+          options: StrokeOptions(size: 5),
+          pageIndex: pageIndex,
+          page: page,
+          toolId: .fountainPen,
+        ),
+      );
+    }
+    coreInfo.pages.add(page);
+  }
+  return coreInfo;
+}
