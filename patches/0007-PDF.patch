+  /// （Saber 会一直留一页空白供书写）。
+  static int pdfExportablePageCount(EditorCoreInfo coreInfo) {
+    final pages = coreInfo.pages;
+    if (pages.isEmpty) return 0;
+    return pages.last.isEmpty ? pages.length - 1 : pages.length;
+  }
+
+  /// 个人自用版：把 1-based 的页范围夹到可导出范围内。
+  ///
+  /// [firstPage] / [lastPage] 是 1-based 闭区间，null 表示"第一页 / 最后一页"。
+  /// 笔记没有可导出的页、或 [firstPage] > [lastPage] 时返回 null。
+  static ({int first, int last})? pdfPageRange(
+    EditorCoreInfo coreInfo, {
+    int? firstPage,
+    int? lastPage,
+  }) {
+    final pageCount = pdfExportablePageCount(coreInfo);
+    if (pageCount <= 0) return null;
+    // num.clamp returns num, so the toInt() is required here
+    final first = (firstPage ?? 1).clamp(1, pageCount).toInt();
+    final last = (lastPage ?? pageCount).clamp(1, pageCount).toInt();
+    if (first > last) return null;
+    return (first: first, last: last);
+  }
