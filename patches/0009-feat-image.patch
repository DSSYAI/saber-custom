diff --git a/lib/components/canvas/image_crop_overlay.dart b/lib/components/canvas/image_crop_overlay.dart
new file mode 100644
index 00000000..9da180c2
--- /dev/null
+++ b/lib/components/canvas/image_crop_overlay.dart
@@ -0,0 +1,201 @@
+import 'dart:math';
+
+import 'package:flutter/material.dart';
+
+/// 个人自用版：图片裁剪的交互层，覆盖在**整张图**之上。
+///
+/// - 裁剪框以外压暗
+/// - 框内拖动可整体移动裁剪框
+/// - 8 个把手拖动改框，自由比例（不锁宽高比）
+///
+/// 坐标系：`cropRect` / `sourceSize` 是**源图像素**，`boxSize` 是图片在屏幕上
+/// 的显示尺寸。本 widget 只负责交互与显示，裁剪框的真值由父级持有，
+/// 每次变化通过 [onChanged] 上报（单向数据流，父级重建）。
+class ImageCropOverlay extends StatelessWidget {
+  const new({
+    super.key,
+    required this.cropRect,
+    required this.sourceSize,
+    required this.boxSize,
+    required this.onChanged,
+  });
+
+  /// 当前裁剪框，单位是源图像素。
+  final Rect cropRect;
+
+  /// 整张图的像素尺寸，[cropRect] 的坐标系。
+  final Size sourceSize;
+
+  /// 图片在屏幕上的显示尺寸。
+  final Size boxSize;
+
+  /// 裁剪框变化时回调（参数为新的裁剪框，源图像素）。
+  final ValueChanged<Rect> onChanged;
+
+  /// 裁剪框的最小边长，单位源图像素。防止拖成一条线。
+  static const minCropSize = 24.0;
+
+  /// 把手（拖动点）的直径。
+  static const _handleSize = 40.0;
+
+  /// 把源图像素的矩形换算成显示坐标。
+  static Rect toDisplay(Rect rect, Size sourceSize, Size boxSize) => Rect.fromLTRB(
+    rect.left / sourceSize.width * boxSize.width,
+    rect.top / sourceSize.height * boxSize.height,
+    rect.right / sourceSize.width * boxSize.width,
+    rect.bottom / sourceSize.height * boxSize.height,
+  );
+
+  /// 屏幕上的位移换算成源图像素上的位移。
+  Offset _toSourceDelta(Offset delta) => Offset(
+    delta.dx / boxSize.width * sourceSize.width,
+    delta.dy / boxSize.height * sourceSize.height,
+  );
+
+  /// 拖动某个把手。[position] 的每个分量是 -1/0/1，表示拖的是哪条边。
+  void _dragHandle(Offset position, Offset delta) {
+    final sourceDelta = _toSourceDelta(delta);
+    var left = cropRect.left;
+    var top = cropRect.top;
+    var right = cropRect.right;
+    var bottom = cropRect.bottom;
+
+    // 每条边都夹在 [图片边界] 与 [对面的边 - 最小尺寸] 之间。
+    // cropRect 始终保证 width/height >= minCropSize，所以这里的夹取下界
+    // 一定不会超过上界。
+    if (position.dx < 0) left = (left + sourceDelta.dx).clamp(0.0, right - minCropSize);
+    if (position.dx > 0) right = (right + sourceDelta.dx).clamp(left + minCropSize, sourceSize.width);
+    if (position.dy < 0) top = (top + sourceDelta.dy).clamp(0.0, bottom - minCropSize);
+    if (position.dy > 0) bottom = (bottom + sourceDelta.dy).clamp(top + minCropSize, sourceSize.height);
+
+    onChanged(Rect.fromLTRB(left, top, right, bottom));
+  }
+
+  /// 拖动裁剪框本身（整体平移，不改变大小）。
+  void _dragCropRect(Offset delta) {
+    final sourceDelta = _toSourceDelta(delta);
+    onChanged(
+      Rect.fromLTWH(
+        (cropRect.left + sourceDelta.dx).clamp(
+          0.0,
+          max(0.0, sourceSize.width - cropRect.width),
+        ),
+        (cropRect.top + sourceDelta.dy).clamp(
+          0.0,
+          max(0.0, sourceSize.height - cropRect.height),
+        ),
+        cropRect.width,
+        cropRect.height,
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final display = toDisplay(cropRect, sourceSize, boxSize);
+    final scrim = Colors.black.withValues(alpha: 0.45);
+
+    return Stack(
+      children: [
+        // 裁剪框以外的四个方向压暗
+        Positioned(
+          left: 0,
+          top: 0,
+          width: boxSize.width,
+          height: max(0, display.top),
+          child: ColoredBox(color: scrim),
+        ),
+        Positioned(
+          left: 0,
+          top: display.bottom,
+          width: boxSize.width,
+          height: max(0, boxSize.height - display.bottom),
+          child: ColoredBox(color: scrim),
+        ),
+        Positioned(
+          left: 0,
+          top: display.top,
+          width: max(0, display.left),
+          height: display.height,
+          child: ColoredBox(color: scrim),
+        ),
+        Positioned(
+          left: display.right,
+          top: display.top,
+          width: max(0, boxSize.width - display.right),
+          height: display.height,
+          child: ColoredBox(color: scrim),
+        ),
+
+        // 框内拖动 = 整体移动裁剪框（放在把手下面，避免盖住把手）
+        Positioned(
+          left: display.left,
+          top: display.top,
+          width: display.width,
+          height: display.height,
+          child: GestureDetector(
+            behavior: HitTestBehavior.opaque,
+            onPanUpdate: (details) => _dragCropRect(details.delta),
+          ),
+        ),
+
+        // 裁剪框边框
+        Positioned(
+          left: display.left,
+          top: display.top,
+          width: display.width,
+          height: display.height,
+          child: IgnorePointer(
+            child: DecoratedBox(
+              decoration: BoxDecoration(
+                border: Border.all(color: Colors.white, width: 2),
+              ),
+            ),
+          ),
+        ),
+
+        for (double x = -1; x <= 1; x += 1)
+          for (double y = -1; y <= 1; y += 1)
+            if (x != 0 || y != 0) _handle(context, Offset(x, y), display),
+      ],
+    );
+  }
+
+  /// 把手的 key，便于测试按位置精确点到某个把手。
+  @visibleForTesting
+  static Key handleKey(Offset position) =>
+      ValueKey('cropHandle${position.dx},${position.dy}');
+
+  Widget _handle(BuildContext context, Offset position, Rect display) {
+    final colorScheme = ColorScheme.of(context);
+    return Positioned(
+      // 注意要加上 display.left/top：裁剪框不一定贴着图片左上角，
+      // 只乘 display.width/height 会把所有把手挤到左上角附近。
+      left:
+          display.left +
+          (position.dx + 1) / 2 * display.width -
+          _handleSize / 2,
+      top:
+          display.top +
+          (position.dy + 1) / 2 * display.height -
+          _handleSize / 2,
+      child: MouseRegion(
+        cursor: SystemMouseCursors.precise,
+        child: GestureDetector(
+          key: handleKey(position),
+          behavior: HitTestBehavior.opaque,
+          onPanUpdate: (details) => _dragHandle(position, details.delta),
+          child: Container(
+            width: _handleSize,
+            height: _handleSize,
+            decoration: BoxDecoration(
+              color: colorScheme.onSurface,
+              shape: .circle,
+              border: Border.all(color: colorScheme.surface, width: 2),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
