diff --git a/test/image_crop_overlay_test.dart b/test/image_crop_overlay_test.dart
new file mode 100644
index 00000000..f7172758
--- /dev/null
+++ b/test/image_crop_overlay_test.dart
@@ -0,0 +1,188 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:saber/components/canvas/image_crop_overlay.dart';
+
+/// 个人自用版：裁剪框交互层的几何验证。
+///
+/// 只验证"拖动 → 新的裁剪框"这段纯几何逻辑（源图像素 ↔ 屏幕像素换算、
+/// 边界夹取、最小尺寸、把手位置），不涉及完整编辑器的装配。
+///
+/// 断言用**极大的拖动距离**触发夹取，这样触摸 slop 消耗掉的那几个像素
+/// 不影响结果，测试不会因为 slop 常数变化而变脆。
+void main() {
+  const sourceSize = Size(200, 200);
+  const boxSize = Size(100, 100);
+  // 源图 200px 显示在 100px 的框里 → 屏幕 1px = 源图 2px
+  const fullCrop = Rect.fromLTWH(0, 0, 200, 200);
+
+  group('把手位置', () {
+    testWidgets('handles sit on the edges of the crop rect, not the box', (
+      tester,
+    ) async {
+      // 裁剪框在图片中间：这正是"把手只乘 display.width/height 而忘记加
+      // display.left/top"这个 bug 会暴露的场景（把手会全挤到左上角）
+      await tester.pumpWidget(
+        _wrap(
+          ImageCropOverlay(
+            cropRect: const Rect.fromLTWH(50, 50, 100, 100),
+            sourceSize: sourceSize,
+            boxSize: boxSize,
+            onChanged: (_) {},
+          ),
+        ),
+      );
+
+      // 源图 50..150 → 显示 25..75
+      expect(_center(tester, const Offset(1, 1)), const Offset(75, 75));
+      expect(_center(tester, const Offset(-1, -1)), const Offset(25, 25));
+      expect(_center(tester, const Offset(0, 1)), const Offset(50, 75));
+      expect(_center(tester, const Offset(-1, 0)), const Offset(25, 50));
+      expect(_center(tester, const Offset(1, 0)), const Offset(75, 50));
+    });
+  });
+
+  group('拖动把手改裁剪框', () {
+    testWidgets('dragging the right edge inwards shrinks the crop', (
+      tester,
+    ) async {
+      final result = await _drag(
+        tester,
+        cropRect: fullCrop,
+        start: const Offset(96, 50), // 右边中点，稍微往里一点避免踩到边界
+        delta: const Offset(-1000, 0),
+      );
+
+      expect(result, isNotNull);
+      expect(result!.left, 0, reason: 'the left edge must not move');
+      expect(
+        result.right,
+        ImageCropOverlay.minCropSize,
+        reason: 'the right edge stops at the minimum crop width',
+      );
+    });
+
+    testWidgets('dragging the left edge outwards shrinks the crop', (
+      tester,
+    ) async {
+      final result = await _drag(
+        tester,
+        cropRect: fullCrop,
+        start: const Offset(4, 50),
+        delta: const Offset(1000, 0),
+      );
+
+      expect(result, isNotNull);
+      expect(
+        result!.right,
+        sourceSize.width,
+        reason: 'the right edge stays put',
+      );
+      expect(result.left, sourceSize.width - ImageCropOverlay.minCropSize);
+    });
+
+    testWidgets('dragging the bottom edge upwards shrinks the crop', (
+      tester,
+    ) async {
+      final result = await _drag(
+        tester,
+        cropRect: fullCrop,
+        start: const Offset(50, 96),
+        delta: const Offset(0, -1000),
+      );
+
+      expect(result, isNotNull);
+      expect(result!.top, 0);
+      expect(result.bottom, ImageCropOverlay.minCropSize);
+    });
+
+    testWidgets('the crop cannot grow beyond the image', (tester) async {
+      final result = await _drag(
+        tester,
+        cropRect: fullCrop,
+        start: const Offset(4, 50),
+        delta: const Offset(-1000, 0),
+      );
+
+      expect(result, isNotNull);
+      expect(result!.left, 0, reason: 'clamped to the left edge of the image');
+      expect(result.right, sourceSize.width);
+    });
+  });
+
+  group('拖动裁剪框本身', () {
+    testWidgets('dragging inside the crop moves it without resizing', (
+      tester,
+    ) async {
+      const crop = Rect.fromLTWH(50, 50, 100, 100);
+      final result = await _drag(
+        tester,
+        cropRect: crop,
+        start: const Offset(50, 50), // 显示坐标下的裁剪框中心
+        delta: const Offset(30, 40),
+      );
+
+      expect(result, isNotNull);
+      expect(result!.width, crop.width, reason: 'size must not change');
+      expect(result.height, crop.height);
+      expect(result.left, greaterThan(crop.left), reason: 'moved right');
+      expect(result.top, greaterThan(crop.top), reason: 'moved down');
+    });
+
+    testWidgets('the crop cannot be dragged outside the image', (tester) async {
+      const crop = Rect.fromLTWH(100, 100, 100, 100);
+      final result = await _drag(
+        tester,
+        cropRect: crop,
+        start: const Offset(75, 75), // 显示 50..100 的中心
+        delta: const Offset(1000, 1000),
+      );
+
+      expect(result, isNotNull);
+      expect(result!.left, sourceSize.width - crop.width);
+      expect(result.top, sourceSize.height - crop.height);
+      expect(result.right, lessThanOrEqualTo(sourceSize.width));
+      expect(result.bottom, lessThanOrEqualTo(sourceSize.height));
+    });
+  });
+}
+
+/// 把手中心相对裁剪层左上角的位置（即"显示坐标"）。
+Offset _center(WidgetTester tester, Offset position) {
+  final origin = tester.getTopLeft(find.byType(ImageCropOverlay));
+  return tester.getCenter(find.byKey(ImageCropOverlay.handleKey(position))) -
+      origin;
+}
+
+Future<Rect?> _drag(
+  WidgetTester tester, {
+  required Rect cropRect,
+  required Offset start,
+  required Offset delta,
+}) async {
+  Rect? changed;
+  await tester.pumpWidget(
+    _wrap(
+      ImageCropOverlay(
+        cropRect: cropRect,
+        sourceSize: const Size(200, 200),
+        boxSize: const Size(100, 100),
+        onChanged: (rect) => changed = rect,
+      ),
+    ),
+  );
+
+  final origin = tester.getTopLeft(find.byType(ImageCropOverlay));
+  // 分两步：第一步越过触摸 slop（会被 DragStartBehavior.start 吃掉），
+  // 第二步才是真正被上报的位移。
+  final gesture = await tester.startGesture(origin + start);
+  await gesture.moveBy(const Offset(40, 40));
+  await gesture.moveBy(delta);
+  await gesture.up();
+  await tester.pump();
+
+  return changed;
+}
+
+Widget _wrap(Widget child) => MaterialApp(
+  home: Center(child: SizedBox(width: 100, height: 100, child: child)),
+);
