--- /dev/null
+++ b/lib/components/canvas/cropped_image.dart
@@ -0,0 +1,75 @@
+import 'package:flutter/material.dart';
+
+/// 个人自用版：只显示 [child] 的一个子矩形（[srcRect]），并拉伸填满可用空间。
+///
+/// Flutter 自带的 [BoxFit] 只能缩放进整张图，无法只显示图的一部分。
+///
+/// Saber 的图片数据里其实早就有 `srcRect` 这个字段（存进笔记是 `sx/sy/sw/sh`，
+/// 见 `image/editor_image.dart`），但**渲染路径从来没有真正用它**：
+/// `canvas_image.dart` 里的 `SizedOverflowBox(size: srcRect.size)` 在外层紧约束下
+/// 是个空操作，而 `srcRect.topLeft` 又恒为 (0,0)。所以过去把 `srcRect` 设成子矩形，
+/// 界面上不会有任何变化 —— 裁剪功能必须先把这段补上。
+///
+/// 坐标系：[srcRect] 与 [sourceSize] 用的是同一个像素坐标系，
+/// 也就是"整张图"的尺寸（缩略图情况见调用方如何处理）。
+///
+/// 未裁剪时本 widget 的输出与 `BoxFit.fill` 直接铺满父约束**一致**，
+/// 所以它可以安全地只用在"确实裁剪了"的分支上。
+class CroppedImage extends StatelessWidget {
+  const new({
+    super.key,
+    required this.srcRect,
+    required this.sourceSize,
+    required this.child,
+  });
+
+  /// 要显示的那块区域，单位是源图像素。
+  final Rect srcRect;
+
+  /// 整张图的像素尺寸，[srcRect] 的坐标系。
+  final Size sourceSize;
+
+  /// 整张图的内容；会被摆放在 [sourceSize] 大小的盒子里，
+  /// 因此任何"铺满"类型的 fit 在这里都是 1:1。
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context) {
+    final sourceWidth = sourceSize.width;
+    final sourceHeight = sourceSize.height;
+    if (srcRect.width <= 0 ||
+        srcRect.height <= 0 ||
+        sourceWidth <= 0 ||
+        sourceHeight <= 0) {
+      return child;
+    }
+
+    // 裁剪窗口在源图里的位置，换算成 0..1 的比例。
+    // 用 FractionalOffset 正好能直接表达"窗口左上角对齐盒子左上角"。
+    final double fractionX = sourceWidth == srcRect.width
+        ? 0
+        : srcRect.left / (sourceWidth - srcRect.width);
+    final double fractionY = sourceHeight == srcRect.height
+        ? 0
+        : srcRect.top / (sourceHeight - srcRect.height);
+
+    return FittedBox(
+      // 与未裁剪时的 BoxFit.fill 行为一致：拉伸填满，不保持比例
+      fit: BoxFit.fill,
+      child: ClipRect(
+        // Align 的 widthFactor/heightFactor 把盒子缩到裁剪区域大小，
+        // 并按 fraction 把整图偏移到正确位置；ClipRect 裁掉窗口外的部分。
+        child: Align(
+          alignment: FractionalOffset(fractionX, fractionY),
+          widthFactor: srcRect.width / sourceWidth,
+          heightFactor: srcRect.height / sourceHeight,
+          child: SizedBox(
+            width: sourceWidth,
+            height: sourceHeight,
+            child: child,
+          ),
+        ),
+      ),
+    );
+  }
+}
diff --git a/test/cropped_image_test.dart b/test/cropped_image_test.dart
new file mode 100644
index 00000000..d510279b
--- /dev/null
+++ b/test/cropped_image_test.dart
@@ -0,0 +1,221 @@
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:image/image.dart' as im;
+import 'package:saber/components/canvas/canvas_image.dart';
+import 'package:saber/components/canvas/cropped_image.dart';
+
+/// 个人自用版：裁剪渲染的验证。
+///
+/// 背景：`srcRect`（存进笔记是 `sx/sy/sw/sh`）一直是"显示源图的哪一块"，
+/// 但改动前的渲染路径（`SizedOverflowBox(size: srcRect.size)` + 恒为 (0,0) 的
+/// translate）在外层紧约束下是个空操作，所以把它设成子矩形界面上毫无变化。
+/// 这组测试用真实像素证明裁剪确实生效了。
+void main() {
+  group('CanvasImage.isCropped', () {
+    const source = Size(100, 50);
+    const full = Rect.fromLTWH(0, 0, 100, 50);
+
+    test('the full image is not a crop', () {
+      expect(
+        CanvasImage.isCropped(srcRect: full, sourceSize: source),
+        isFalse,
+      );
+    });
+
+    test('a sub-rect is a crop', () {
+      expect(
+        CanvasImage.isCropped(
+          srcRect: const Rect.fromLTWH(10, 0, 90, 50),
+          sourceSize: source,
+        ),
+        isTrue,
+      );
+      expect(
+        CanvasImage.isCropped(
+          srcRect: const Rect.fromLTWH(0, 0, 100, 25),
+          sourceSize: source,
+        ),
+        isTrue,
+      );
+      expect(
+        CanvasImage.isCropped(
+          srcRect: const Rect.fromLTWH(0, 10, 100, 40),
+          sourceSize: source,
+        ),
+        isTrue,
+      );
+    });
+
+    test('float noise from a save/load round trip is tolerated', () {
+      expect(
+        CanvasImage.isCropped(
+          srcRect: const Rect.fromLTWH(0, 0, 100.2, 49.8),
+          sourceSize: source,
+        ),
+        isFalse,
+      );
+    });
+
+    test('zero rects are not a crop', () {
+      // eg. pdf page images keep srcRect at zero
+      expect(CanvasImage.isCropped(srcRect: Rect.zero, sourceSize: source), isFalse);
+      // eg. an image whose natural size isn't known yet
+      expect(
+        CanvasImage.isCropped(srcRect: full, sourceSize: Size.zero),
+        isFalse,
+      );
+    });
+
+    test('thumbnails are never treated as cropped', () {
+      // a thumbnail's srcRect lives in the thumbnail's coordinate space,
+      // where it doesn't match naturalSize
+      expect(
+        CanvasImage.isCropped(
+          srcRect: const Rect.fromLTWH(10, 5, 40, 20),
+          sourceSize: source,
+          isThumbnail: true,
+        ),
+        isFalse,
+      );
+    });
+  });
+
+  group('CroppedImage', () {
+    // The source is 100x50: left half red, right half blue.
+    const sourceSize = Size(100, 50);
+
+    testWidgets('without a crop, the whole image is shown', (tester) async {
+      final pixels = await _render(tester, srcRect: Offset.zero & sourceSize);
+
+      expect(pixels.at(10, 20), _red, reason: 'left side comes from the red half');
+      expect(pixels.at(70, 20), _blue, reason: 'right side comes from the blue half');
+    });
+
+    testWidgets('cropping the right half hides the red half', (tester) async {
+      final pixels = await _render(
+        tester,
+        srcRect: const Rect.fromLTWH(50, 0, 50, 50),
+      );
+
+      expect(pixels.at(5, 20), _blue);
+      expect(pixels.at(70, 20), _blue);
+    });
+
+    testWidgets('cropping the left half hides the blue half', (tester) async {
+      final pixels = await _render(
+        tester,
+        srcRect: const Rect.fromLTWH(0, 0, 50, 50),
+      );
+
+      expect(pixels.at(5, 20), _red);
+      expect(pixels.at(70, 20), _red);
+    });
+
+    testWidgets('the cropped region is stretched across the whole box', (
+      tester,
+    ) async {
+      // source x 25..75 => the left 40% of the box is red, the right 60% blue
+      final pixels = await _render(
+        tester,
+        srcRect: const Rect.fromLTWH(25, 0, 50, 50),
+      );
+
+      expect(pixels.at(2, 20), _red, reason: 'just inside the left edge');
+      expect(pixels.at(30, 20), _red, reason: 'source x=44, still red');
+      expect(pixels.at(50, 20), _blue, reason: 'source x=56, now blue');
+      expect(pixels.at(77, 20), _blue, reason: 'just inside the right edge');
+    });
+
+    testWidgets('cropping vertically works too', (tester) async {
+      // the source is horizontally split, so crop a tall thin strip and only
+      // check that it renders without the other axis leaking in
+      final pixels = await _render(
+        tester,
+        srcRect: const Rect.fromLTWH(0, 0, 100, 25),
+      );
+
+      expect(pixels.at(10, 2), _red);
+      expect(pixels.at(70, 2), _blue);
+    });
+  });
+}
+
+const _red = (r: 255, g: 0, b: 0);
+const _blue = (r: 0, g: 0, b: 255);
+
+final _boundaryKey = GlobalKey();
+
+/// Renders [CroppedImage] with a red/blue test image and returns the pixels.
+Future<_Pixels> _render(
+  WidgetTester tester, {
+  required Rect srcRect,
+}) async {
+  late ui.Image source;
+  await tester.runAsync(() async {
+    source = await _redBlueImage();
+  });
+
+  await tester.pumpWidget(
+    MaterialApp(
+      home: Center(
+        child: RepaintBoundary(
+          key: _boundaryKey,
+          child: SizedBox(
+            width: 80,
+            height: 40,
+            child: CroppedImage(
+              srcRect: srcRect,
+              sourceSize: const Size(100, 50),
+              child: RawImage(image: source, fit: BoxFit.fill),
+            ),
+          ),
+        ),
+      ),
+    ),
+  );
+  await tester.pumpAndSettle();
+
+  late _Pixels pixels;
+  await tester.runAsync(() async {
+    final boundary = tester.renderObject<RenderRepaintBoundary>(
+      find.byKey(_boundaryKey),
+    );
+    final rendered = await boundary.toImage(pixelRatio: 1);
+    final data = await rendered.toByteData(format: ui.ImageByteFormat.rawRgba);
+    pixels = _Pixels(data!, 80, 40);
+    rendered.dispose();
+  });
+  return pixels;
+}
+
+/// A 100x50 image: left half red, right half blue.
+Future<ui.Image> _redBlueImage() async {
+  final image = im.Image(width: 100, height: 50);
+  for (var y = 0; y < 50; y++) {
+    for (var x = 0; x < 100; x++) {
+      final isLeft = x < 50;
+      image.setPixelRgba(x, y, isLeft ? 255 : 0, 0, isLeft ? 0 : 255, 255);
+    }
+  }
+  final codec = await ui.instantiateImageCodec(
+    Uint8List.fromList(im.encodePng(image)),
+  );
+  final frame = await codec.getNextFrame();
+  return frame.image;
+}
+
+class _Pixels(final ByteData data, final int width, final int height) {
+  ({int r, int g, int b}) at(int x, int y) {
+    assert(x >= 0 && x < width && y >= 0 && y < height);
+    final offset = (y * width + x) * 4;
+    return (
+      r: data.getUint8(offset),
+      g: data.getUint8(offset + 1),
+      b: data.getUint8(offset + 2),
+    );
+  }
+}
