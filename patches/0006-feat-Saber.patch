@@ -0,0 +1,66 @@
+import 'dart:typed_data';
+
+/// 个人自用版：从文件头（魔数）判定图片的真实格式，返回带点的扩展名。
+///
+/// 为什么需要它：安卓相册（Photo Picker）返回的是系统临时副本，文件名不一定带
+/// 正确扩展名，而从文件选择器导入时扩展名又完全依赖文件名。而这个扩展名会被
+/// `PngEditorImage` **写进 `.sbn2` 笔记数据**，判错会让笔记里的图片坏掉，
+/// 所以以字节内容为准、文件名只作兜底。
+///
+/// 返回 null 表示无法从内容识别（例如 TGA/PVRTC 没有可靠的头部魔数），
+/// 此时调用方应退回按文件名判定。
+String? sniffImageExtension(Uint8List bytes) {
+  if (bytes.length < 4) return null;
+
+  bool startsWith(List<int> magic, [int offset = 0]) {
+    if (bytes.length < offset + magic.length) return false;
+    for (var i = 0; i < magic.length; i++) {
+      if (bytes[offset + i] != magic[i]) return false;
+    }
+    return true;
+  }
+
+  // PNG: 89 50 4E 47 0D 0A 1A 0A
+  if (startsWith(const [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A])) {
+    return '.png';
+  }
+  // JPEG: FF D8 FF
+  if (startsWith(const [0xFF, 0xD8, 0xFF])) return '.jpg';
+  // GIF: "GIF8"
+  if (startsWith(const [0x47, 0x49, 0x46, 0x38])) return '.gif';
+  // WebP: "RIFF" .... "WEBP"
+  if (startsWith(const [0x52, 0x49, 0x46, 0x46]) &&
+      startsWith(const [0x57, 0x45, 0x42, 0x50], 8)) {
+    return '.webp';
+  }
+  // BMP: "BM"
+  if (startsWith(const [0x42, 0x4D])) return '.bmp';
+  // TIFF: little endian "II*\0" 或 big endian "MM\0*"
+  if (startsWith(const [0x49, 0x49, 0x2A, 0x00]) ||
+      startsWith(const [0x4D, 0x4D, 0x00, 0x2A])) {
+    return '.tiff';
+  }
+  // ICO / CUR: 00 00 01 00 / 00 00 02 00
+  if (startsWith(const [0x00, 0x00, 0x01, 0x00])) return '.ico';
+  // PSD: "8BPS"
+  if (startsWith(const [0x38, 0x42, 0x50, 0x53])) return '.psd';
+  // OpenEXR: 76 2F 31 01
+  if (startsWith(const [0x76, 0x2F, 0x31, 0x01])) return '.exr';
+  // SVG: 文本格式，先跳过前导空白/BOM/XML 声明再找 "<svg"
+  final svg = _sniffSvg(bytes);
+  if (svg) return '.svg';
+
+  return null;
+}
+
+bool _sniffSvg(Uint8List bytes) {
+  // 只检查开头一小段，避免大文件全量解码
+  final head = bytes.length > 1024 ? bytes.sublist(0, 1024) : bytes;
+  String text;
+  try {
+    text = String.fromCharCodes(head);
+  } catch (_) {
+    return false;
+  }
+  return text.contains('<svg') || text.contains('<?xml');
+}
