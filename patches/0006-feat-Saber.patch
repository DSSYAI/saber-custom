+    private fun handleIncomingIntent(intent: Intent?) {
+        if (intent == null) return
+        if (intent.action != Intent.ACTION_VIEW) return
+        val uri: Uri = intent.data ?: return
+
+        if (uri.scheme == "file") {
+            deliver(uri.path)
+            return
+        }
+        if (uri.scheme != "content" && uri.scheme != "android.resource") {
+            Log.w(TAG, "Ignoring unsupported uri scheme: ${uri.scheme}")
+            return
+        }
+
+        // 后台线程复制，避免大 PDF 阻塞启动导致 ANR
+        Thread {
+            try {
+                deliver(copyToCache(uri))
+            } catch (e: Exception) {
+                Log.e(TAG, "Failed to copy incoming file: $uri", e)
+            }
+        }.start()
+    }
+
+    private fun deliver(path: String?) {
+        if (path == null) return
+        // 先存入待取槽，再尝试推送：推送万一落在 Dart 尚未注册 handler 的窗口里，
+        // Dart 启动后调用 getInitialFile 仍能取到。
+        pendingPath = path
+
+        val methodChannel = channel
+        if (methodChannel == null) {
+            Log.i(TAG, "Dart not ready yet, keeping $path pending")
+            return
+        }
+        runOnUiThread { methodChannel.invokeMethod(METHOD_NEW, path) }
+    }
+
+    private fun copyToCache(uri: Uri): String? {
+        val displayName = queryDisplayName(uri) ?: "incoming_${System.currentTimeMillis()}"
+        val dir = File(cacheDir, "incoming").apply { mkdirs() }
+
+        val safeName = displayName.replace(Regex("[/\\\\]"), "_")
+        var target = File(dir, safeName)
+        if (target.exists()) {
+            // 同一个文件反复打开时不要互相覆盖
+            target = File(dir, "${System.currentTimeMillis()}_$safeName")
+        }
+
+        contentResolver.openInputStream(uri).use { input ->
+            if (input == null) {
+                Log.e(TAG, "openInputStream returned null for $uri")
+                return null
+            }
+            target.outputStream().use { output -> input.copyTo(output) }
+        }
+        Log.i(TAG, "Copied incoming file to ${target.absolutePath}")
+        return target.absolutePath
+    }
+
+    /** 取原始文件名（例如微信的「生物化学实验CB.pdf」），拿不到就退回 URI 末段。 */
+    private fun queryDisplayName(uri: Uri): String? {
+        try {
+            contentResolver.query(uri, null, null, null, null)?.use { cursor ->
+                val index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
+                if (index >= 0 && cursor.moveToFirst()) {
+                    val name = cursor.getString(index)
+                    if (!name.isNullOrBlank()) return ensureExtension(name, uri)
+                }
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Failed to query display name for $uri", e)
+        }
+        return uri.lastPathSegment?.let { ensureExtension(it, uri) }
+    }
+
+    /** 有些 provider 的显示名不带扩展名；用 MIME 补一个，否则 Dart 侧判不出文件类型。 */
+    private fun ensureExtension(name: String, uri: Uri): String {
+        if (name.contains('.')) return name
+        val mime = try {
+            contentResolver.getType(uri)
+        } catch (e: Exception) {
+            Log.w(TAG, "Failed to get mime type for $uri", e)
+            null
+        }
+        val extension = mime?.let { MimeTypeMap.getSingleton().getExtensionFromMimeType(it) }
+        return if (extension.isNullOrBlank()) name else "$name.$extension"
+    }
+}
