+  @visibleForTesting
+  static double normaliseRotationDegrees(double degrees) {
+    var value = degrees % 360;
+    if (value > 180) value -= 360;
+    if (value <= -180) value += 360;
+
+    final nearestQuarter = (value / 90).round() * 90.0;
+    final snapped = (value - nearestQuarter).abs() <= 5
+        ? nearestQuarter
