+/// 个人自用版：图片正上方的旋转箭头，拖动即可自由旋转。
+///
+/// 它占的位置原本是"顶部中间那个缩放把手"（两者会重叠），所以那个把手
+/// 撤掉了 —— 顶部仍然可以用两个上角拉伸。
+///
+/// 位置：圆心正好压在图片上边缘，靠 [CanvasImage.handlePadding] 那一圈
+/// 提供的可命中区域，所以整圆都点得到（见第六批修的那个 bug）。
+class _CanvasImageRotateHandle extends StatelessWidget {
+  const new({
+    required this.active,
+    required this.image,
+    required this.onRotateStart,
+    required this.onRotateUpdate,
+    required this.onRotateEnd,
+  });
+
+  final bool active;
+  final EditorImage image;
+  final void Function(Offset globalPosition) onRotateStart;
+  final void Function(Offset globalPosition) onRotateUpdate;
+  final VoidCallback onRotateEnd;
+
+  @override
+  Widget build(BuildContext context) {
+    final colorScheme = ColorScheme.of(context);
+    final double boxWidth = max(
+      image.dstRect.width,
+      CanvasImage.minInteractiveSize,
+    );
+    const double size = CanvasImage.handleSize;
+    return Positioned(
+      left: CanvasImage.handlePadding + boxWidth / 2 - size / 2,
+      top: CanvasImage.handlePadding - size / 2,
+      child: DeferPointer(
+        paintOnTop: true,
+        child: MouseRegion(
+          cursor: active ? SystemMouseCursors.grab : MouseCursor.defer,
+          child: GestureDetector(
+            key: const ValueKey('imageRotateHandle'),
+            behavior: HitTestBehavior.opaque,
+            onPanStart: active ? (d) => onRotateStart(d.globalPosition) : null,
+            onPanUpdate: active
+                ? (d) => onRotateUpdate(d.globalPosition)
+                : null,
+            onPanEnd: active ? (_) => onRotateEnd() : null,
+            child: AnimatedOpacity(
+              opacity: active ? 1 : 0,
+              duration: const Duration(milliseconds: 100),
+              child: Container(
+                width: size,
+                height: size,
+                decoration: BoxDecoration(
+                  color: colorScheme.primary,
+                  shape: .circle,
+                  border: Border.all(color: colorScheme.surface, width: 2),
+                ),
+                child: Icon(
+                  Icons.rotate_right,
+                  size: size * 0.6,
+                  color: colorScheme.onPrimary,
+                ),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
