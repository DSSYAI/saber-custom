diff --git a/test/image_orientation_test.dart b/test/image_orientation_test.dart
new file mode 100644
index 00000000..48340edc
--- /dev/null
+++ b/test/image_orientation_test.dart
@@ -0,0 +1,127 @@
+import 'dart:typed_data';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:saber/components/canvas/_asset_cache.dart';
+import 'package:saber/components/canvas/canvas_image.dart';
+import 'package:saber/components/canvas/image/editor_image.dart';
+
+/// 个人自用版：图片"方向"（自由旋转 + 水平翻转）的验证。
+///
+/// 两件最容易静默失效的事：
+/// 1. 新字段存了没读回来（所以做 toJson → fromJson 往返）
+/// 2. 旋转角度的吸附规则（否则手动几乎转不回正，或者反过来吸得太多、
+///    自由旋转变得不自由）
+void main() {
+  group('normaliseRotationDegrees', () {
+    test('free angles are kept as they are', () {
+      expect(CanvasImage.normaliseRotationDegrees(37), 37);
+      expect(CanvasImage.normaliseRotationDegrees(-42.5), -42.5);
+    });
+
+    test('angles close to a quarter turn snap to it', () {
+      expect(CanvasImage.normaliseRotationDegrees(2), 0);
+      expect(CanvasImage.normaliseRotationDegrees(-3), 0);
+      expect(CanvasImage.normaliseRotationDegrees(88), 90);
+      expect(CanvasImage.normaliseRotationDegrees(-92), -90);
+      expect(CanvasImage.normaliseRotationDegrees(183), 180);
+    });
+
+    test('angles further than 5 degrees away do not snap', () {
+      // 这正是"自由旋转"要保住的部分：只有接近时才吸附
+      expect(CanvasImage.normaliseRotationDegrees(6), 6);
+      expect(CanvasImage.normaliseRotationDegrees(84), 84);
+      expect(CanvasImage.normaliseRotationDegrees(-6), -6);
+    });
+
+    test('wraps into (-180, 180]', () {
+      expect(CanvasImage.normaliseRotationDegrees(370), 10);
+      expect(CanvasImage.normaliseRotationDegrees(-370), -10);
+      expect(CanvasImage.normaliseRotationDegrees(540), 180);
+    });
+  });
+
+  group('orientation persistence', () {
+    final bytes = Uint8List.fromList([1, 2, 3, 4]);
+
+    PngEditorImage image({
+      double rotationDegrees = 0,
+      bool flipHorizontal = false,
+    }) => PngEditorImage(
+      id: 1,
+      assetCache: AssetCache(),
+      extension: '.png',
+      imageProvider: MemoryImage(bytes),
+      pageIndex: 0,
+      pageSize: .infinite,
+      onMoveImage: null,
+      onDeleteImage: null,
+      onMiscChange: null,
+      rotationDegrees: rotationDegrees,
+      flipHorizontal: flipHorizontal,
+    );
+
+    EditorImage reload(Map<String, dynamic> json) => EditorImage.fromJson(
+      json,
+      inlineAssets: [bytes],
+      sbnPath: '/Notes/Test',
+      assetCache: AssetCache(),
+    );
+
+    test('defaults are not written to the note', () {
+      final json = image().toJson(OrderedAssetCache());
+      expect(json.containsKey('r'), isFalse);
+      expect(json.containsKey('fh'), isFalse);
+    });
+
+    test('rotation and flip survive a save/load round trip', () {
+      final json = image(
+        rotationDegrees: 37.5,
+        flipHorizontal: true,
+      ).toJson(OrderedAssetCache());
+      expect(json['r'], 37.5);
+      expect(json['fh'], isTrue);
+
+      final reloaded = reload(json);
+      expect(reloaded.rotationDegrees, 37.5);
+      expect(reloaded.flipHorizontal, isTrue);
+    });
+
+    test('a note without the fields loads as unrotated and unflipped', () {
+      final reloaded = reload(image().toJson(OrderedAssetCache()));
+      expect(reloaded.rotationDegrees, 0);
+      expect(reloaded.flipHorizontal, isFalse);
+      expect(reloaded.hasOrientationAdjustments, isFalse);
+    });
+  });
+
+  group('the orientation getter and setter', () {
+    test('round trip, and drive hasOrientationAdjustments', () {
+      final image = PngEditorImage(
+        id: 1,
+        assetCache: AssetCache(),
+        extension: '.png',
+        imageProvider: MemoryImage(Uint8List.fromList([1])),
+        pageIndex: 0,
+        pageSize: .infinite,
+        onMoveImage: null,
+        onDeleteImage: null,
+        onMiscChange: null,
+      );
+
+      expect(image.hasOrientationAdjustments, isFalse);
+
+      image.orientation = (rotationDegrees: 12, flipHorizontal: true);
+      expect(image.rotationDegrees, 12);
+      expect(image.flipHorizontal, isTrue);
+      expect(image.hasOrientationAdjustments, isTrue);
+
+      // 只翻转也算"调整过"
+      image.orientation = (rotationDegrees: 0, flipHorizontal: true);
+      expect(image.hasOrientationAdjustments, isTrue);
+
+      image.orientation = (rotationDegrees: 0, flipHorizontal: false);
+      expect(image.hasOrientationAdjustments, isFalse);
+    });
+  });
+}
