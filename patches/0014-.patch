+import 'package:defer_pointer/defer_pointer.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:image/image.dart' as im;
+import 'package:saber/components/canvas/_asset_cache.dart';
+import 'package:saber/components/canvas/canvas_image.dart';
+import 'package:saber/components/canvas/image/editor_image.dart';
+import 'package:saber/components/canvas/image_crop_overlay.dart';
+
+/// 个人自用版：挂载真的 [CanvasImage] 做的**端到端**测试。
+///
+/// 旋转部分：前两批"手感不对"都出在这一层 —— 位置算对了、但拖动时箭头从手指
+/// 底下溜走。所以这里用真的指针事件拖它，断言：
+///   1. 箭头跟着手指走（转 90° 后它还在手指底下）；
+///   2. 松手后角度存住（并且产生一条可撤销的记录）；
+///   3. 旋转过程中动作条一动不动（不再随外接矩形上下跳）；
+///   4. 90° 时把手框没被外层格子夹扁（第八批"越转越小"的残留）。
+///
+/// 裁剪层对齐：第十批把外层格子的尺寸算法改了（格子不再恒等于"把手框 + 2*pad"），
+/// 裁剪交互层的位置必须跟着改，否则会整体偏一个动作条的高度。这里顺手守住它。
+void main() {
+  const pageSize = Size(1000, 1400);
+  // 竖图：300×400，放在页面中间偏下一点
+  const dstRect = Rect.fromLTWH(350, 500, 300, 400);
+  const naturalSize = Size(300, 400);
+
+  /// 合法的 1×1 PNG，只是让 Image 有东西可解；画面内容不参与断言。
+  final onePixelPng = im.encodePng(im.Image(width: 1, height: 1));
+
+  late PngEditorImage image;
+  late List<double> orientationChanges;
+
+  setUp(() {
+    // 测试里不要留下"5 秒后才 loadOut"的定时器
+    EditorImage.shouldLoadOutImmediately = true;
+    addTearDown(() => EditorImage.shouldLoadOutImmediately = false);
+
+    orientationChanges = [];
+    image = PngEditorImage(
+      id: 1,
+      assetCache: AssetCache(),
+      extension: '.png',
+      imageProvider: MemoryImage(onePixelPng),
+      pageIndex: 0,
+      pageSize: pageSize,
+      onMoveImage: null,
+      onDeleteImage: null,
+      onMiscChange: null,
+      // newImage 让它在挂载时就是 active（旋转箭头才可拖）
+      newImage: true,
+      dstRect: dstRect,
+      srcRect: Offset.zero & naturalSize,
+      naturalSize: naturalSize,
+    );
+    image.onOrientationChange = (img, before, after) =>
+        orientationChanges.add(after.rotationDegrees);
+  });
+
+  Future<void> pumpImage(WidgetTester tester) async {
+    // 让整页都在屏幕内：DeferredPointerHandler 的命中测试受它自己的尺寸限制
+    tester.view.physicalSize = pageSize;
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+
+    await tester.pumpWidget(
+      MaterialApp(
+        home: Align(
+          alignment: Alignment.topLeft,
+          child: SizedBox(
+            width: pageSize.width,
+            height: pageSize.height,
+            child: DeferredPointerHandler(
+              child: Stack(
+                children: [
+                  CanvasImage(
+                    filePath: '/Notes/Test',
+                    image: image,
+                    pageSize: pageSize,
+                    setAsBackground: null,
+                  ),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+  }
+
+  testWidgets('the rotate handle starts on the image\'s top edge', (
+    tester,
+  ) async {
+    await pumpImage(tester);
+
+    final handle = find.byKey(const ValueKey('imageRotateHandle'));
+    expect(handle, findsOneWidget);
+
+    final imageCentre = tester.getCenter(find.byType(Image));
+    expect(imageCentre.dx, closeTo(dstRect.center.dx, 0.5));
+    expect(imageCentre.dy, closeTo(dstRect.center.dy, 0.5));
+
+    // 0° 时圆心正好在图片上边缘（也就是"把手框上边缘"）上，水平居中
+    final frameHeight = dstRect.height + CanvasImage.handleInset * 2;
+    final fromCentre = tester.getCenter(handle) - imageCentre;
+    expect(fromCentre.dx.abs(), lessThan(0.5));
+    expect(fromCentre.dy, closeTo(-frameHeight / 2, 0.5));
+  });
+
+  testWidgets('dragging it a quarter turn keeps it under the finger', (
+    tester,
+  ) async {
+    await pumpImage(tester);
+
+    final handle = find.byKey(const ValueKey('imageRotateHandle'));
+    final imageCentre = tester.getCenter(find.byType(Image));
+    final frameHeight = dstRect.height + CanvasImage.handleInset * 2;
+    final radius = frameHeight / 2;
+    final barBefore = tester.getRect(
+      find.byKey(const ValueKey('imageActionBar')),
+    );
+
+    // 先沿半径方向往外挪一点：只为越过 touch slop，角度不变（还是正上方）
+    final gesture = await tester.startGesture(tester.getCenter(handle));
+    await tester.pump();
+    await gesture.moveTo(imageCentre + Offset(0, -(radius + 40)));
+    await tester.pump();
+    // 再绕中心转到正右方（+90°）
+    await gesture.moveTo(imageCentre + Offset(radius, 0));
+    await tester.pump();
+    await gesture.up();
+    await tester.pumpAndSettle();
+
+    expect(image.rotationDegrees, 90);
+
+    // 箭头应该停在"图片中心正右方、半径不变"的地方 —— 也就是手指底下
+    final handleNow = tester.getCenter(handle) - imageCentre;
+    expect(handleNow.dx, closeTo(radius, 1.0));
+    expect(handleNow.dy.abs(), lessThan(1.0));
+
+    // 松手后记一条方向变更（可撤销）
+    expect(orientationChanges, [90]);
+
+    // 动作条在旋转过程中纹丝不动（不再随外接矩形上下跳）。
+    // 只比上下位置和高度：宽度会因为"重置"按钮出现而变宽，那是另一回事。
+    final barAfter = tester.getRect(
+      find.byKey(const ValueKey('imageActionBar')),
+    );
+    expect(barAfter.top, barBefore.top);
+    expect(barAfter.height, barBefore.height);
+  });
+
+  testWidgets('a quarter turn does not squeeze the image', (tester) async {
+    await pumpImage(tester);
+
+    final handle = find.byKey(const ValueKey('imageRotateHandle'));
+    final imageCentre = tester.getCenter(find.byType(Image));
+    final frameHeight = dstRect.height + CanvasImage.handleInset * 2;
+    final radius = frameHeight / 2;
+
+    final gesture = await tester.startGesture(tester.getCenter(handle));
+    await tester.pump();
+    await gesture.moveTo(imageCentre + Offset(0, -(radius + 40)));
+    await tester.pump();
+    await gesture.moveTo(imageCentre + Offset(radius, 0));
+    await tester.pump();
+    await gesture.up();
+    await tester.pumpAndSettle();
+
+    expect(image.rotationDegrees, 90);
+    // 把手框（图片 + 两圈 handleInset）**没有被外层格子夹扁**：
+    // 改动前格子 = 旋转外接矩形 + 2*pad，90° 时它比把手框矮，Center 下发的
+    // 宽松约束会把 SizedBox 夹回去，把手框内部默认 Clip.hardEdge 的 Stack
+    // 于是把图片和边框裁掉一条边（竖图正好少 22px）。
+    expect(
+      tester.getSize(find.byKey(const ValueKey('imageHandleFrame'))),
+      const Size(300 + CanvasImage.handleInset * 2, 400 + CanvasImage.handleInset * 2),
+    );
+  });
+
+  testWidgets('the handle ignores a pointer that sits on the centre', (
+    tester,
+  ) async {
+    await pumpImage(tester);
+
+    final handle = find.byKey(const ValueKey('imageRotateHandle'));
+    final imageCentre = tester.getCenter(find.byType(Image));
+
+    // 手指从箭头出发，但中途穿过图片中心：那里角度是噪声，
+    // 不该让图片乱甩（死区保护的回归测试）
+    final gesture = await tester.startGesture(tester.getCenter(handle));
+    await tester.pump();
+    await gesture.moveTo(imageCentre + const Offset(0, -60));
+    await tester.pump();
+    final degreesBeforeCentre = image.rotationDegrees;
+    await gesture.moveTo(imageCentre + const Offset(2, 0));
+    await tester.pump();
+    await gesture.up();
+    await tester.pump();
+
+    expect(image.rotationDegrees, degreesBeforeCentre);
+  });
+
+  testWidgets('the crop layer stays centred on the image', (tester) async {
+    await pumpImage(tester);
+
+    // 点动作条上的「裁剪」进入裁剪模式
+    await tester.tap(find.byTooltip('裁剪'));
+    await tester.pumpAndSettle();
+
+    final overlay = find.byType(ImageCropOverlay);
+    expect(overlay, findsOneWidget);
+
+    // 裁剪层自己的盒子 = 图片外扩 handlePadding（它内部再按 padding 摆裁剪框）
+    final imageRect = tester.getRect(find.byType(Image));
+    final overlayRect = tester.getRect(overlay);
+    const pad = CanvasImage.handlePadding;
+    expect(overlayRect.left, closeTo(imageRect.left - pad, 0.5));
+    expect(overlayRect.top, closeTo(imageRect.top - pad, 0.5));
+    expect(overlayRect.width, closeTo(imageRect.width + pad * 2, 0.5));
+    expect(overlayRect.height, closeTo(imageRect.height + pad * 2, 0.5));
+  });
+}
