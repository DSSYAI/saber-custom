+
+    test('the frame is never squeezed, at any angle', () {
+      // 回归：格子比把手框小的时候，Center 下发的宽松约束会把 SizedBox 夹回去
+      //（RenderConstrainedBox 的 enforce），它内部默认 Clip.hardEdge 的 Stack
+      // 就裁掉图片一条边 —— 竖图转到 90° 正好命中这种情况。
+      for (final frame in <Size>[portrait, landscape]) {
+        for (final degrees in angles) {
+          final box = boxFor(frame, degrees);
