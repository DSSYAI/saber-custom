+    test('it always keeps the same distance from the centre', () {
+      for (final degrees in <double>[0, 17, 45, 90, 137, 180, -90, -175]) {
+        final offset = CanvasImage.rotateHandleOffset(frame, degrees);
+        expect(
+          offset.distance,
+          closeTo(halfHeight, 0.001),
+          reason: '$degrees degrees',
+        );
+      }
+    });
+
+    test('it stays on the finger\'s ray while dragging', () {
+      // 这就是这批要修的性质：拖箭头时它必须停在手指底下。
+      // 用户是抓着箭头按下去的，所以"指针起始角"= 图片起始角度下箭头自己的方向；
+      // 指针转到 A 之后，箭头的方向必须还是 A（吸附时最多偏 5 度，那是刻意的）。
+      for (final imageStart in <double>[0, 37, 90, -120, 180]) {
+        final pointerStart = directionOf(
+          CanvasImage.rotateHandleOffset(frame, imageStart),
+        );
+        for (final delta in <double>[40, 90, -35, 179]) {
+          final pointerNow = pointerStart + delta;
+          final newDegrees = CanvasImage.normaliseRotationDegrees(
+            imageStart + (pointerNow - pointerStart),
+          );
+          final handleDirection = directionOf(
+            CanvasImage.rotateHandleOffset(frame, newDegrees),
+          );
+          final snapped = newDegrees % 90 == 0;
+          expect(
+            angleGap(handleDirection, pointerNow),
+            lessThanOrEqualTo(snapped ? 5.001 : 0.000001),
+            reason: 'start $imageStart, pointer $pointerNow → $newDegrees',
+          );
+        }
+      }
+    });
+
+    test('it is no longer anchored to the bounding box', () {
+      // 改动前它的位置只由 frameWidth 算、与角度无关：竖图转到 90° 时它在
+      // ((frameW - frameH) / 2, -frameW / 2)，即"旋转后外接矩形的上边缘"，
+      // 而"图片上边缘中点"这时应该在右边 → 两者差 300+ px，这就是手感乱的根源。
+      final oldOffset90 = Offset(
+        (frame.width - frame.height) / 2,
+        -frame.width / 2,
+      );
+      final newOffset90 = CanvasImage.rotateHandleOffset(frame, 90);
+      expect(newOffset90.dx, closeTo(halfHeight, 0.001));
+      expect(newOffset90.dy, closeTo(0, 0.001));
+      expect((newOffset90 - oldOffset90).distance, greaterThan(200));
+    });
+  });
+
+  group('interactionBoxSize', () {
+    const padding = 28.0;
+
+    /// 竖图 / 宽图各一个，旋转时外接矩形变小的那一轴不一样。
+    const portrait = Size(344, 444);
+    const landscape = Size(644, 194);
+
+    const angles = <double>[
+      0,
+      3,
+      17,
+      45,
+      60,
+      89,
+      90,
+      137,
+      180,
+      271.5,
+      -90,
+      -158,
+    ];
+
+    Size boxFor(Size frame, double degrees, {double bottomSpace = 0}) =>
+        CanvasImage.interactionBoxSize(
+          frameSize: frame,
+          degrees: degrees,
+          padding: padding,
+          bottomSpace: bottomSpace,
+        );
+
+    test('at 0 degrees it is just the frame plus padding', () {
+      // 这一条保证 0° 时的画面逐像素不变（golden 靠它）
+      expectSize(boxFor(portrait, 0), const Size(344 + 56, 444 + 56));
+      expectSize(boxFor(landscape, 0), const Size(644 + 56, 194 + 56));
+    });
+
+    test('bottomSpace is added symmetrically', () {
+      // 上下各加一半 → 图片中心仍是格子中心 → 旋转轴不动
+      expectSize(boxFor(portrait, 0, bottomSpace: 50), const Size(400, 600));
+    });
+
+    test('minWidth widens the box without touching the height', () {
+      final box = CanvasImage.interactionBoxSize(
+        frameSize: portrait,
+        degrees: 0,
+        padding: padding,
+        minWidth: 1000,
