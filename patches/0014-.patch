+          );
+          expect(
+            box.height,
+            greaterThanOrEqualTo(frame.height + padding * 2 - 0.001),
+            reason: '$frame @ $degrees',
+          );
+        }
+      }
+    });
+
+    test('the action bar always fits inside the box', () {
+      // 动作条顶 = 格子中心 + 把手框高/2 + 8；它必须整条落在格子里
+      //（格子边界之外的东西在 Flutter 里点不到）
+      const bottomSpace = CanvasImage.actionBarHeight + 8;
+      for (final frame in <Size>[portrait, landscape]) {
+        for (final degrees in angles) {
+          final box = boxFor(frame, degrees, bottomSpace: bottomSpace);
+          final barTop = box.height / 2 + frame.height / 2 + 8;
+          expect(
+            barTop + CanvasImage.actionBarHeight,
+            lessThanOrEqualTo(box.height + 0.001),
+            reason: '$frame @ $degrees',
+          );
+        }
+      }
+    });
+
+    test('the rotate handle always fits inside the box', () {
+      const half = CanvasImage.handleSize / 2;
+      for (final frame in <Size>[portrait, landscape]) {
+        for (final degrees in angles) {
+          final box = boxFor(frame, degrees);
+          final offset = CanvasImage.rotateHandleOffset(frame, degrees);
+          expect(
+            box.width / 2 + offset.dx.abs() + half,
+            lessThanOrEqualTo(box.width + 0.001),
+            reason: '$frame @ $degrees',
+          );
+          expect(
+            box.height / 2 + offset.dy.abs() + half,
+            lessThanOrEqualTo(box.height + 0.001),
+            reason: '$frame @ $degrees',
+          );
+        }
+      }
+    });
+  });
